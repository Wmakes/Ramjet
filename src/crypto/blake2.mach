# BLAKE2s (RFC 7693) and its 8-way parallel tree mode BLAKE2sp
#
# BLAKE2sp hashes 64-byte stripes round-robin into 8 leaf BLAKE2s instances
# (fanout 8, depth 2, inner length 32, node offset = leaf index), then hashes
# the 8 leaf digests with a root instance (node depth 1). the last leaf and
# the root are flagged as last nodes. this is the tree mode of the BLAKE2
# paper (blake2.net), with no key and a 32-byte digest.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use B: ramjet.bytes;

val IV0: u32 = 0x6A09E667;
val IV1: u32 = 0xBB67AE85;
val IV2: u32 = 0x3C6EF372;
val IV3: u32 = 0xA54FF53A;
val IV4: u32 = 0x510E527F;
val IV5: u32 = 0x9B05688C;
val IV6: u32 = 0x1F83D9AB;
val IV7: u32 = 0x5BE0CD19;

var sigma:       [160]u8;
var sigma_ready: bool = false;

fun init_sigma() {
    if (sigma_ready) { ret; }
    # the ten message schedules of BLAKE2s
    val rows: str   = "0123456789abcdefea489fd61c02b753b8c052fdae3671947931dcbe265a40f8905724afe1bc683d2c6a0b834d75fe19c51fed4a0763928bdb7ec13950f4862a6fe9b308c2d714a5a2847615fb9e3cd0";
    var i:    usize = 0;
    for (i < 160) {
        val c: u8 = rows[i];
        if (c >= 'a') { sigma[i] = c - 'a' + 10; }
        or            { sigma[i] = c - '0'; }
        i = i + 1;
    }
    sigma_ready = true;
}

fun rotr(x: u32, n: u32) u32 {
    ret (x >> n) | (x << (32 - n));
}

# one BLAKE2s instance
# ---
# h:         chaining value
# t:         bytes compressed so far
# buf:       pending input, compressed only once more input arrives so the
#            last block can carry the final flag
# last_node: set the second finalization flag on the last block
pub rec Blake2s {
    h:         [8]u32;
    t:         u64;
    buf:       [64]u8;
    buf_len:   usize;
    last_node: bool;
}

fun compress(s: *Blake2s, block: *u8, last: bool) {
    var m: [16]u32;
    var v: [16]u32;
    var i: usize = 0;
    for (i < 16) {
        m[i] = B.load_u32(?block[i * 4]);
        i    = i + 1;
    }
    i = 0;
    for (i < 8) {
        v[i] = s.h[i];
        i    = i + 1;
    }
    v[8]  = IV0;
    v[9]  = IV1;
    v[10] = IV2;
    v[11] = IV3;
    v[12] = IV4 ^ (s.t & 0xFFFFFFFF)::u32;
    v[13] = IV5 ^ (s.t >> 32)::u32;
    v[14] = IV6;
    v[15] = IV7;
    if (last)                { v[14] = ~v[14]; }
    if (last && s.last_node) { v[15] = ~v[15]; }

    var r: usize = 0;
    for (r < 10) {
        val sg: *u8 = ?sigma[r * 16];
        g(?v[0], 0, 4, 8, 12, m[sg[0]::usize], m[sg[1]::usize]);
        g(?v[0], 1, 5, 9, 13, m[sg[2]::usize], m[sg[3]::usize]);
        g(?v[0], 2, 6, 10, 14, m[sg[4]::usize], m[sg[5]::usize]);
        g(?v[0], 3, 7, 11, 15, m[sg[6]::usize], m[sg[7]::usize]);
        g(?v[0], 0, 5, 10, 15, m[sg[8]::usize], m[sg[9]::usize]);
        g(?v[0], 1, 6, 11, 12, m[sg[10]::usize], m[sg[11]::usize]);
        g(?v[0], 2, 7, 8, 13, m[sg[12]::usize], m[sg[13]::usize]);
        g(?v[0], 3, 4, 9, 14, m[sg[14]::usize], m[sg[15]::usize]);
        r = r + 1;
    }
    i = 0;
    for (i < 8) {
        s.h[i] = s.h[i] ^ v[i] ^ v[i + 8];
        i      = i + 1;
    }
}

fun g(v: *u32, a: usize, b: usize, c: usize, d: usize, x: u32, y: u32) {
    v[a] = v[a] + v[b] + x;
    v[d] = rotr(v[d] ^ v[a], 16);
    v[c] = v[c] + v[d];
    v[b] = rotr(v[b] ^ v[c], 12);
    v[a] = v[a] + v[b] + y;
    v[d] = rotr(v[d] ^ v[a], 8);
    v[c] = v[c] + v[d];
    v[b] = rotr(v[b] ^ v[c], 7);
}

# start an instance from its parameter block fields
# ---
# fanout, depth:     tree shape (1, 1 for plain BLAKE2s)
# node_offset:  position of this node in its level
# node_depth:   0 for leaves
# inner_length: digest size of the inner nodes (0 for plain BLAKE2s)
pub fun init_param(s: *Blake2s, fanout: u8, depth: u8, node_offset: u64, node_depth: u8, inner_length: u8) {
    init_sigma();
    var p: [32]u8;
    var i: usize = 0;
    for (i < 32) {
        p[i] = 0;
        i    = i + 1;
    }
    p[0]        = 32;
    p[1]        = 0;
    p[2]        = fanout;
    p[3]        = depth;
    p[8]        = (node_offset & 0xFF)::u8;
    p[9]        = ((node_offset >> 8) & 0xFF)::u8;
    p[10]       = ((node_offset >> 16) & 0xFF)::u8;
    p[11]       = ((node_offset >> 24) & 0xFF)::u8;
    p[12]       = ((node_offset >> 32) & 0xFF)::u8;
    p[13]       = ((node_offset >> 40) & 0xFF)::u8;
    p[14]       = node_depth;
    p[15]       = inner_length;
    s.h[0]      = IV0 ^ B.load_u32(?p[0]);
    s.h[1]      = IV1 ^ B.load_u32(?p[4]);
    s.h[2]      = IV2 ^ B.load_u32(?p[8]);
    s.h[3]      = IV3 ^ B.load_u32(?p[12]);
    s.h[4]      = IV4 ^ B.load_u32(?p[16]);
    s.h[5]      = IV5 ^ B.load_u32(?p[20]);
    s.h[6]      = IV6 ^ B.load_u32(?p[24]);
    s.h[7]      = IV7 ^ B.load_u32(?p[28]);
    s.t         = 0;
    s.buf_len   = 0;
    s.last_node = false;
}

# plain BLAKE2s-256 with no key
pub fun init(s: *Blake2s) {
    init_param(s, 1, 1, 0, 0, 0);
}

pub fun update(s: *Blake2s, data: *u8, n: usize) {
    var off: usize = 0;
    for (off < n) {
        if (s.buf_len == 64) {
            s.t = s.t + 64;
            compress(s, ?s.buf[0], false);
            s.buf_len = 0;
        }
        var take: usize = 64 - s.buf_len;
        if (take > n - off) { take = n - off; }
        var i: usize = 0;
        for (i < take) {
            s.buf[s.buf_len + i] = data[off + i];
            i                    = i + 1;
        }
        s.buf_len = s.buf_len + take;
        off       = off + take;
    }
}

pub fun final(s: *Blake2s, out: *u8) {
    s.t = s.t + s.buf_len::u64;
    var i: usize = s.buf_len;
    for (i < 64) {
        s.buf[i] = 0;
        i        = i + 1;
    }
    compress(s, ?s.buf[0], true);
    i = 0;
    for (i < 8) {
        B.store_u32(?out[i * 4], s.h[i]);
        i = i + 1;
    }
}

# BLAKE2sp state: 8 leaves and the count of bytes routed so far
pub rec Blake2sp {
    leaf:  [8]Blake2s;
    total: u64;
}

pub fun sp_init(s: *Blake2sp) {
    var i: usize = 0;
    for (i < 8) {
        init_param(?s.leaf[i], 8, 2, i::u64, 0, 32);
        i = i + 1;
    }
    s.leaf[7].last_node = true;
    s.total             = 0;
}

pub fun sp_update(s: *Blake2sp, data: *u8, n: usize) {
    var off: usize = 0;
    for (off < n) {
        # bytes left in the current 64-byte stripe and the leaf it belongs to
        val in_stripe: usize = (s.total % 64)::usize;
        val leaf:      usize = ((s.total / 64) % 8)::usize;
        var take:      usize = 64 - in_stripe;
        if (take > n - off) { take = n - off; }
        update(?s.leaf[leaf], ?data[off], take);
        s.total = s.total + take::u64;
        off     = off + take;
    }
}

pub fun sp_final(s: *Blake2sp, out: *u8) {
    var digests: [256]u8;
    var i:       usize = 0;
    for (i < 8) {
        final(?s.leaf[i], ?digests[i * 32]);
        i = i + 1;
    }
    var root: Blake2s;
    init_param(?root, 8, 2, 0, 1, 32);
    root.last_node = true;
    update(?root, ?digests[0], 256);
    final(?root, out);
}

test blake2__blake2s_abc {
    # RFC 7693 appendix B: BLAKE2s-256("abc")
    var s: Blake2s;
    init(?s);
    update(?s, "abc"::*u8, 3);
    var d: [32]u8;
    final(?s, ?d[0]);
    if (d[0] != 0x50 || d[1] != 0x8C || d[2] != 0x5E || d[31] != 0x82) { ret 1; }
    ret 0;
}
