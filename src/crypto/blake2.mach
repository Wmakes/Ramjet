# BLAKE2s (RFC 7693) and its 8-way parallel tree mode BLAKE2sp
#
# BLAKE2sp hashes 64-byte stripes round-robin into 8 leaf BLAKE2s instances
# (fanout 8, depth 2, inner length 32, node offset = leaf index), then hashes
# the 8 leaf digests with a root instance (node depth 1). the last leaf and
# the root are flagged as last nodes. this is the tree mode of the BLAKE2
# paper (blake2.net), with no key and a 32-byte digest.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use B: ramjet.bytes;
use M: ramjet.mem;

val IV0: u32 = 0x6A09E667;
val IV1: u32 = 0xBB67AE85;
val IV2: u32 = 0x3C6EF372;
val IV3: u32 = 0xA54FF53A;
val IV4: u32 = 0x510E527F;
val IV5: u32 = 0x9B05688C;
val IV6: u32 = 0x1F83D9AB;
val IV7: u32 = 0x5BE0CD19;

fun rotr(x: u32, n: u32) u32 {
    ret (x >> n) | (x << (32 - n));
}

# one BLAKE2s instance
# ---
# h:         chaining value
# t:         bytes compressed so far
# buf:       pending input, compressed only once more input arrives so the
#            last block can carry the final flag
# last_node: set the second finalization flag on the last block
pub rec Blake2s {
    h:         [8]u32;
    t:         u64;
    buf:       [64]u8;
    buf_len:   usize;
    last_node: bool;
}

# the BLAKE2s compression function, unrolled: ten rounds of eight G steps
# with the message schedule resolved here, every word in a local
fun compress(s: *Blake2s, block: *u8, last: bool) {
    val m0:  u32 = B.load_u32(?block[0]);
    val m1:  u32 = B.load_u32(?block[4]);
    val m2:  u32 = B.load_u32(?block[8]);
    val m3:  u32 = B.load_u32(?block[12]);
    val m4:  u32 = B.load_u32(?block[16]);
    val m5:  u32 = B.load_u32(?block[20]);
    val m6:  u32 = B.load_u32(?block[24]);
    val m7:  u32 = B.load_u32(?block[28]);
    val m8:  u32 = B.load_u32(?block[32]);
    val m9:  u32 = B.load_u32(?block[36]);
    val m10: u32 = B.load_u32(?block[40]);
    val m11: u32 = B.load_u32(?block[44]);
    val m12: u32 = B.load_u32(?block[48]);
    val m13: u32 = B.load_u32(?block[52]);
    val m14: u32 = B.load_u32(?block[56]);
    val m15: u32 = B.load_u32(?block[60]);
    var v0:  u32 = s.h[0];
    var v1:  u32 = s.h[1];
    var v2:  u32 = s.h[2];
    var v3:  u32 = s.h[3];
    var v4:  u32 = s.h[4];
    var v5:  u32 = s.h[5];
    var v6:  u32 = s.h[6];
    var v7:  u32 = s.h[7];
    var v8:  u32 = IV0;
    var v9:  u32 = IV1;
    var v10: u32 = IV2;
    var v11: u32 = IV3;
    var v12: u32 = IV4 ^ (s.t & 0xFFFFFFFF)::u32;
    var v13: u32 = IV5 ^ (s.t >> 32)::u32;
    var v14: u32 = IV6;
    var v15: u32 = IV7;
    if (last)                { v14 = ~v14; }
    if (last && s.last_node) { v15 = ~v15; }
    # round 0
    v0  = v0 + v4 + m0;
    v12 = v12 ^ v0;
    v12 = (v12 >> 16) | (v12 << 16);
    v8  = v8 + v12;
    v4  = v4 ^ v8;
    v4  = (v4 >> 12) | (v4 << 20);
    v0  = v0 + v4 + m1;
    v12 = v12 ^ v0;
    v12 = (v12 >> 8) | (v12 << 24);
    v8  = v8 + v12;
    v4  = v4 ^ v8;
    v4  = (v4 >> 7) | (v4 << 25);
    v1  = v1 + v5 + m2;
    v13 = v13 ^ v1;
    v13 = (v13 >> 16) | (v13 << 16);
    v9  = v9 + v13;
    v5  = v5 ^ v9;
    v5  = (v5 >> 12) | (v5 << 20);
    v1  = v1 + v5 + m3;
    v13 = v13 ^ v1;
    v13 = (v13 >> 8) | (v13 << 24);
    v9  = v9 + v13;
    v5  = v5 ^ v9;
    v5  = (v5 >> 7) | (v5 << 25);
    v2  = v2 + v6 + m4;
    v14 = v14 ^ v2;
    v14 = (v14 >> 16) | (v14 << 16);
    v10 = v10 + v14;
    v6  = v6 ^ v10;
    v6  = (v6 >> 12) | (v6 << 20);
    v2  = v2 + v6 + m5;
    v14 = v14 ^ v2;
    v14 = (v14 >> 8) | (v14 << 24);
    v10 = v10 + v14;
    v6  = v6 ^ v10;
    v6  = (v6 >> 7) | (v6 << 25);
    v3  = v3 + v7 + m6;
    v15 = v15 ^ v3;
    v15 = (v15 >> 16) | (v15 << 16);
    v11 = v11 + v15;
    v7  = v7 ^ v11;
    v7  = (v7 >> 12) | (v7 << 20);
    v3  = v3 + v7 + m7;
    v15 = v15 ^ v3;
    v15 = (v15 >> 8) | (v15 << 24);
    v11 = v11 + v15;
