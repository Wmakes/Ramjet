# CRC-32 (IEEE 802.3, reflected polynomial 0xEDB88320), slicing by 8
#
# eight 256-entry tables let the loop fold eight input bytes per step. the
# value is the standard CRC-32: init, update over any split, final.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

var table: [2048]u32;
var ready: bool = false;

fun build() {
    var i: usize = 0;
    for (i < 256) {
        var c: u32   = i::u32;
        var k: usize = 0;
        for (k < 8) {
            if ((c & 1) != 0) { c = 0xEDB88320 ^ (c >> 1); }
            or                { c = c >> 1; }
            k = k + 1;
        }
        table[i] = c;
        i        = i + 1;
    }
    i = 0;
    for (i < 256) {
        var t: usize = 1;
        for (t < 8) {
            val prev: u32 = table[(t - 1) * 256 + i];
            table[t * 256 + i] = (prev >> 8) ^ table[(prev & 0xFF)::usize];
            t                  = t + 1;
        }
        i = i + 1;
    }
    ready = true;
}

pub fun init() u32 {
    if (!ready) { build(); }
    ret 0xFFFFFFFF;
}

pub fun update(crc: u32, data: *u8, n: usize) u32 {
    if (!ready) { build(); }
    var c: u32   = crc;
    var i: usize = 0;
    for (i + 8 <= n) {
        val lo: u32 = c ^ (data[i]::u32 | (data[i + 1]::u32 << 8) | (data[i + 2]::u32 << 16) | (data[i + 3]::u32 << 24));
        val hi: u32 = data[i + 4]::u32 | (data[i + 5]::u32 << 8) | (data[i + 6]::u32 << 16) | (data[i + 7]::u32 << 24);
        c = table[7 * 256 + (lo & 0xFF)::usize] ^ table[6 * 256 + ((lo >> 8) & 0xFF)::usize] ^
            table[5 * 256 + ((lo >> 16) & 0xFF)::usize] ^ table[4 * 256 + (lo >> 24)::usize] ^
            table[3 * 256 + (hi & 0xFF)::usize] ^ table[2 * 256 + ((hi >> 8) & 0xFF)::usize] ^
            table[256 + ((hi >> 16) & 0xFF)::usize] ^ table[(hi >> 24)::usize];
        i = i + 8;
    }
    for (i < n) {
        c = table[((c ^ data[i]::u32) & 0xFF)::usize] ^ (c >> 8);
        i = i + 1;
    }
    ret c;
}

pub fun final(crc: u32) u32 {
    ret crc ^ 0xFFFFFFFF;
}

pub fun hash(data: *u8, n: usize) u32 {
    ret final(update(init(), data, n));
}

test crc32__check_value {
    # the standard check value of CRC-32 over "123456789"
    if (hash("123456789"::*u8, 9) != 0xCBF43926) { ret 1; }
    # split updates agree with one pass, across the 8-byte stride
    var c: u32 = init();
    c = update(c, "12345"::*u8, 5);
    c = update(c, "6789"::*u8, 4);
    if (final(c) != 0xCBF43926) { ret 2; }
    var buf: [100]u8;
    var i:   usize = 0;
    for (i < 100) {
        buf[i] = (i * 7)::u8;
        i      = i + 1;
    }
    var d: u32 = init();
    d = update(d, ?buf[0], 13);
    d = update(d, ?buf[13], 87);
    if (final(d) != hash(?buf[0], 100)) { ret 3; }
    ret 0;
}
