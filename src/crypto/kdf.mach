# HMAC-SHA256 (RFC 2104) and PBKDF2 (RFC 8018)
#
# PBKDF2 here exposes its running block so a caller can keep iterating past
# the nominal count, which is how RAR5 derives its extra values.

use sha: std.crypto.hash.sha256;
use std.types.size.usize;

# HMAC keyed state: SHA-256 after absorbing the inner and outer key pads
pub rec Hmac {
    inner: sha.State;
    outer: sha.State;
}

pub fun hmac_init(h: *Hmac, key: *u8, key_len: usize) {
    var k: [64]u8;
    var i: usize = 0;
    for (i < 64) {
        k[i] = 0;
        i    = i + 1;
    }
    if (key_len > 64) {
        sha.hash(key, key_len, ?k[0]);
    }
    or {
        i = 0;
        for (i < key_len) {
            k[i] = key[i];
            i    = i + 1;
        }
    }
    var pad: [64]u8;
    i = 0;
    for (i < 64) {
        pad[i] = k[i] ^ 0x36;
        i      = i + 1;
    }
    h.inner = sha.init();
    sha.update(?h.inner, ?pad[0], 64);
    i = 0;
    for (i < 64) {
        pad[i] = k[i] ^ 0x5C;
        i      = i + 1;
    }
    h.outer = sha.init();
    sha.update(?h.outer, ?pad[0], 64);
}

# MAC of one message under a keyed state, which is left unchanged
pub fun hmac(h: *Hmac, msg: *u8, len: usize, out: *u8) {
    var s:            sha.State = h.inner;
    var inner_digest: [32]u8;
    sha.update(?s, msg, len);
    sha.final(?s, ?inner_digest[0]);
    var o: sha.State = h.outer;
    sha.update(?o, ?inner_digest[0], 32);
    sha.final(?o, out);
}

# one-shot HMAC-SHA256
pub fun hmac_once(key: *u8, key_len: usize, msg: *u8, len: usize, out: *u8) {
    var h: Hmac;
    hmac_init(?h, key, key_len);
    hmac(?h, msg, len, out);
}

# state of the first PBKDF2 block: U_i and the running XOR of U_1..U_i
pub rec Pbkdf2 {
    mac: Hmac;
    u:   [32]u8;
    acc: [32]u8;
}

# start block 1 over password and salt: computes U_1
pub fun pbkdf2_start(p: *Pbkdf2, password: *u8, pw_len: usize, salt: *u8, salt_len: usize) {
    hmac_init(?p.mac, password, pw_len);
    var msg: [68]u8;
    var i:   usize = 0;
    for (i < salt_len && i < 64) {
        msg[i] = salt[i];
        i      = i + 1;
    }
    msg[i]     = 0;
    msg[i + 1] = 0;
    msg[i + 2] = 0;
    msg[i + 3] = 1;
    hmac(?p.mac, ?msg[0], i + 4, ?p.u[0]);
    i = 0;
    for (i < 32) {
        p.acc[i] = p.u[i];
        i        = i + 1;
    }
}

# run n more iterations, folding each U into the accumulator
pub fun pbkdf2_more(p: *Pbkdf2, n: u64) {
    var k:    u64 = 0;
    var next: [32]u8;
    for (k < n) {
        hmac(?p.mac, ?p.u[0], 32, ?next[0]);
        var i: usize = 0;
        for (i < 32) {
            p.u[i]   = next[i];
            p.acc[i] = p.acc[i] ^ next[i];
            i        = i + 1;
        }
        k = k + 1;
    }
}

test kdf__hmac_rfc4231_case2 {
    # RFC 4231 test case 2: key "Jefe"
    var out: [32]u8;
    hmac_once("Jefe"::*u8, 4, "what do ya want for nothing?"::*u8, 28, ?out[0]);
    if (out[0] != 0x5B || out[1] != 0xDC || out[2] != 0xC1 || out[31] != 0x43) { ret 1; }
    ret 0;
}

test kdf__pbkdf2_sha256 {
    # PBKDF2-HMAC-SHA256, P="password", S="salt", c=2, dkLen=32
    # (published vector, RFC 7914 style): ae4d0c95af6b46d32d0adff928f06dd0
    var p: Pbkdf2;
    pbkdf2_start(?p, "password"::*u8, 8, "salt"::*u8, 4);
    pbkdf2_more(?p, 1);
    if (p.acc[0] != 0xAE || p.acc[1] != 0x4D || p.acc[2] != 0x0C || p.acc[3] != 0x95) { ret 1; }
    ret 0;
}
