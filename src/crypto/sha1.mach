# SHA-1 (FIPS 180-4)
#
# only used to derive RAR 2.9-4.x encryption keys, where the format fixes the
# hash; it is not used for anything that needs collision resistance.

use std.types.size.usize;

pub rec Sha1 {
    h:       [5]u32;
    buf:     [64]u8;
    buf_len: usize;
    total:   u64;
}

fun rotl(x: u32, n: u32) u32 {
    ret (x << n) | (x >> (32 - n));
}

pub fun init(s: *Sha1) {
    s.h[0]    = 0x67452301;
    s.h[1]    = 0xEFCDAB89;
    s.h[2]    = 0x98BADCFE;
    s.h[3]    = 0x10325476;
    s.h[4]    = 0xC3D2E1F0;
    s.buf_len = 0;
    s.total   = 0;
}

fun compress(s: *Sha1, p: *u8) {
    var w: [80]u32;
    var i: usize = 0;
    for (i < 16) {
        w[i] = (p[i * 4]::u32 << 24) | (p[i * 4 + 1]::u32 << 16) | (p[i * 4 + 2]::u32 << 8) | p[i * 4 + 3]::u32;
        i    = i + 1;
    }
    for (i < 80) {
        w[i] = rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
        i    = i + 1;
    }
    var a: u32 = s.h[0];
    var b: u32 = s.h[1];
    var c: u32 = s.h[2];
    var d: u32 = s.h[3];
    var e: u32 = s.h[4];
    i = 0;
    for (i < 80) {
        var f: u32 = 0;
        var k: u32 = 0;
        if (i < 20) {
            f = (b & c) | (~b & d);
            k = 0x5A827999;
        }
        or (i < 40) {
            f = b ^ c ^ d;
            k = 0x6ED9EBA1;
        }
        or (i < 60) {
            f = (b & c) | (b & d) | (c & d);
            k = 0x8F1BBCDC;
        }
        or {
            f = b ^ c ^ d;
            k = 0xCA62C1D6;
        }
        val t: u32 = rotl(a, 5) + f + e + k + w[i];
        e = d;
        d = c;
        c = rotl(b, 30);
        b = a;
        a = t;
        i = i + 1;
    }
    s.h[0] = s.h[0] + a;
    s.h[1] = s.h[1] + b;
    s.h[2] = s.h[2] + c;
    s.h[3] = s.h[3] + d;
    s.h[4] = s.h[4] + e;
}

pub fun update(s: *Sha1, data: *u8, n: usize) {
    var i: usize = 0;
    s.total = s.total + n::u64;
    for (i < n) {
        s.buf[s.buf_len] = data[i];
        s.buf_len        = s.buf_len + 1;
        if (s.buf_len == 64) {
            compress(s, ?s.buf[0]);
            s.buf_len = 0;
        }
        i = i + 1;
    }
}

# SHA-1 as RAR 2.9-4.x hashes passwords: when one update covers whole
# 64-byte blocks of the caller's buffer (beyond what completes a pending
# block), each such block is overwritten, after it is hashed, with the last
# 16 words of its message schedule (little endian). the digest of this call
# is ordinary SHA-1; the next call sees the overwritten bytes.
pub fun update_rar(s: *Sha1, data: *u8, n: usize) {
    val first: usize = 64 - s.buf_len;
    if (n <= first) {
        update(s, data, n);
        ret;
    }
    update(s, data, first);
    var off: usize = first;
    for (off + 64 <= n) {
        update(s, ?data[off], 64);
        garble(?data[off]);
        off = off + 64;
    }
    update(s, ?data[off], n - off);
}

fun garble(p: *u8) {
    var w: [16]u32;
    var i: usize = 0;
    for (i < 16) {
        w[i] = (p[i * 4]::u32 << 24) | (p[i * 4 + 1]::u32 << 16) | (p[i * 4 + 2]::u32 << 8) | p[i * 4 + 3]::u32;
        i    = i + 1;
    }
    for (i < 80) {
        w[i & 15] = rotl(w[(i + 13) & 15] ^ w[(i + 8) & 15] ^ w[(i + 2) & 15] ^ w[i & 15], 1);
        i         = i + 1;
    }
    i = 0;
    for (i < 64) {
        p[i] = ((w[i / 4] >> (8 * (i % 4))::u32) & 0xFF)::u8;
        i    = i + 1;
    }
}

# write the 20-byte digest; the state is consumed
pub fun final(s: *Sha1, out: *u8) {
    val bits: u64   = s.total * 8;
    var pad:  [72]u8;
    var n:    usize = 0;
    pad[0] = 0x80;
    n      = 1;
    for ((s.buf_len + n) % 64 != 56) {
        pad[n] = 0;
        n      = n + 1;
    }
    var i: usize = 0;
    for (i < 8) {
        pad[n + i] = ((bits >> (56 - 8 * i)::u64) & 0xFF)::u8;
        i          = i + 1;
    }
    val total: u64 = s.total;
    update(s, ?pad[0], n + 8);
    s.total = total;
    i       = 0;
    for (i < 5) {
        out[i * 4]     = (s.h[i] >> 24)::u8;
        out[i * 4 + 1] = ((s.h[i] >> 16) & 0xFF)::u8;
        out[i * 4 + 2] = ((s.h[i] >> 8) & 0xFF)::u8;
        out[i * 4 + 3] = (s.h[i] & 0xFF)::u8;
        i              = i + 1;
    }
}

test sha1__fips_vectors {
    # FIPS 180-2 appendix A: SHA-1("abc") = a9993e36 4706816a ba3e2571 7850c26c 9cd0d89d
    var s: Sha1;
    init(?s);
    update(?s, "abc"::*u8, 3);
    var d: [20]u8;
    final(?s, ?d[0]);
    if (d[0] != 0xA9 || d[1] != 0x99 || d[2] != 0x3E || d[19] != 0x9D) { ret 1; }
    # the two-block message "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    init(?s);
    update(?s, "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"::*u8, 56);
    final(?s, ?d[0]);
    if (d[0] != 0x84 || d[1] != 0x98 || d[2] != 0x3E || d[19] != 0xF1) { ret 2; }
    ret 0;
}
