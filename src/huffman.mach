# canonical prefix codes read MSB first, as RAR 2.9 and RAR 5 use them
#
# codes are assigned in order of (length, symbol). decoding takes the next
# 16 bits of input, left aligned, and reports the symbol and how many bits
# its code used, so any bit reader can drive it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val MAX_SYMS:   usize = 306;
pub val QUICK_BITS: u32   = 10;
pub val INVALID:    u32   = 0xFFFF;

# a code table
# ---
# limit: limit[l] is one past the last code of length l, left-aligned to 16
#        bits; codes of length l are those in [limit[l-1], limit[l])
# first: index in syms of the first symbol of each length
# syms:  symbols sorted by (length, value)
# quick_len, quick_sym: direct lookup on the top QUICK_BITS bits; length 0
#        means the code is longer and needs the limit walk
pub rec Huff {
    limit:     [17]u32;
    first:     [17]u32;
    syms:      [306]u16;
    nsyms:     u32;
    quick_len: [1024]u8;
    quick_sym: [1024]u16;
}

# build a code from n lengths (0-15, 0 = unused); false when the lengths
# over-subscribe the code space
pub fun build(h: *Huff, lengths: *u8, n: usize) bool {
    if (n > MAX_SYMS) { ret false; }
    var count: [16]u32;
    var i:     usize = 0;
    for (i < 16) {
        count[i] = 0;
        i        = i + 1;
    }
    i = 0;
    for (i < n) {
        count[(lengths[i] & 15)::usize] = count[(lengths[i] & 15)::usize] + 1;
        i                               = i + 1;
    }
    count[0] = 0;

    var code: u32 = 0;
    h.limit[0] = 0;
    h.first[0] = 0;
    var l:   usize = 1;
    var idx: u32   = 0;
    for (l < 16) {
        code = code + (count[l] << (16 - l)::u32);
        if (code > 0x10000) { ret false; }
        h.limit[l] = code;
        h.first[l] = idx;
        idx        = idx + count[l];
        l          = l + 1;
    }
    h.limit[16] = 0x10000;
    h.first[16] = idx;
    h.nsyms     = idx;

    var next: [16]u32;
    l = 0;
    for (l < 16) {
        next[l] = h.first[l];
        l       = l + 1;
    }
    i = 0;
    for (i < n) {
        val len: usize = (lengths[i] & 15)::usize;
        if (len != 0) {
            h.syms[next[len]::usize] = i::u16;
            next[len]                = next[len] + 1;
        }
        i = i + 1;
    }

    val qsize: usize = 1::usize << QUICK_BITS::usize;
    i = 0;
    for (i < qsize) {
        h.quick_len[i] = 0;
        h.quick_sym[i] = 0;
        i              = i + 1;
    }
    l = 1;
    for (l <= QUICK_BITS::usize) {
        var c: u32 = h.limit[l - 1];
        var k: u32 = h.first[l];
        for (k < h.first[l] + count[l]) {
            val lo:   usize = (c >> (16 - QUICK_BITS))::usize;
            val span: usize = 1::usize << (QUICK_BITS::usize - l);
            var j:    usize = 0;
            for (j < span) {
                h.quick_len[lo + j] = l::u8;
                h.quick_sym[lo + j] = h.syms[k::usize];
                j                   = j + 1;
            }
            c = c + (1::u32 << (16 - l)::u32);
            k = k + 1;
        }
        l = l + 1;
    }
    ret true;
}

# decode the code at the top of `bits` (16 bits, left aligned)
# ---
# ret: symbol | (code length << 16); symbol INVALID when nothing matches
pub fun lookup(h: *Huff, bits: u32) u32 {
    val q:  usize = (bits >> (16 - QUICK_BITS))::usize;
    val ql: u8    = h.quick_len[q];
    if (ql != 0) { ret h.quick_sym[q]::u32 | (ql::u32 << 16); }
    var l: usize = QUICK_BITS::usize + 1;
    for (l < 16) {
        if (bits < h.limit[l]) {
            val k: u32 = h.first[l] + ((bits - h.limit[l - 1]) >> (16 - l)::u32);
            if (k >= h.nsyms) { ret INVALID | (l::u32 << 16); }
            ret h.syms[k::usize]::u32 | (l::u32 << 16);
        }
        l = l + 1;
    }
    ret INVALID | (15::u32 << 16);
}

test huffman__canonical_codes {
    # lengths 2,1,3,3 -> codes: sym1 "0", sym0 "10", sym2 "110", sym3 "111"
    var lens: [4]u8;
    lens[0] = 2;
    lens[1] = 1;
    lens[2] = 3;
    lens[3] = 3;
    var h: Huff;
    if (!build(?h, ?lens[0], 4))                    { ret 1; }
    if (lookup(?h, 0x0000) != (1 | (1::u32 << 16))) { ret 2; }
    if (lookup(?h, 0x8000) != (0 | (2::u32 << 16))) { ret 3; }
    if (lookup(?h, 0xC000) != (2 | (3::u32 << 16))) { ret 4; }
    if (lookup(?h, 0xE000) != (3 | (3::u32 << 16))) { ret 5; }
    # over-subscribed: three codes of length 1
    lens[0] = 1;
    lens[1] = 1;
    lens[2] = 1;
    lens[3] = 0;
    if (build(?h, ?lens[0], 4)) { ret 6; }
    ret 0;
}
