# the ciphers of RAR 1.5 and RAR 2.0 (unpack versions 15 and 20/26)
#
# both derive their state from the password alone, with no salt.
#
#   RAR 1.5: a byte stream cipher; four 16-bit keys seeded from the
#            password's CRC32 register and stepped through the CRC table
#   RAR 2.0: a 16-byte block cipher with a 32-round Feistel structure over
#            a password-shuffled substitution table; the keys are folded
#            with the CRC table after every block
#
# written from the format as The Unarchiver's XADMaster (LGPL-2.1) handles
# it, read only; see docs/clean-room-notes.md. the substitution table is a
# constant of the format.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use B: ramjet.bytes;
use ramjet.crypto.crc32;

# ---------------------------------------------------------------- RAR 1.5

pub rec Rar15 {
    k0: u32;
    k1: u32;
    k2: u32;
    k3: u32;
}

fun ror16(v: u32, n: u32) u32 {
    val x: u32 = v & 0xFFFF;
    ret ((x >> n) | (x << (16 - n))) & 0xFFFF;
}

pub fun rar15_init(c: *Rar15, pw: *u8, n: usize) {
    val reg: u32 = crc32.update(crc32.init(), pw, n);
    c.k0 = reg & 0xFFFF;
    c.k1 = (reg >> 16) & 0xFFFF;
    c.k2 = 0;
    c.k3 = 0;
    var i: usize = 0;
    for (i < n) {
        val b: u32 = pw[i]::u32;
        val t: u32 = crc32.table_entry(b);
        c.k2 = (c.k2 ^ b ^ t) & 0xFFFF;
        c.k3 = (c.k3 + b + (t >> 16)) & 0xFFFF;
        i    = i + 1;
    }
}

pub fun rar15_byte(c: *Rar15, b: u8) u8 {
    c.k0 = (c.k0 + 0x1234) & 0xFFFF;
    val t: u32 = crc32.table_entry((c.k0 >> 1) & 0xFF);
    c.k1 = (c.k1 ^ t) & 0xFFFF;
    c.k2 = (c.k2 - (t >> 16)) & 0xFFFF;
    c.k0 = c.k0 ^ c.k2;
    c.k3 = ror16(c.k3, 1) ^ c.k1;
    c.k3 = ror16(c.k3, 1);
    c.k0 = c.k0 ^ c.k3;
    ret b ^ ((c.k0 >> 8) & 0xFF)::u8;
}

# ---------------------------------------------------------------- RAR 2.0

pub rec Rar20 {
    key:   [4]u32;
    table: [256]u8;
}

val SUBST: [256]u8 = [256]u8{
    215, 19, 149, 35, 73, 197, 192, 205, 249, 28, 16, 119, 48, 221, 2, 42,
    232, 1, 177, 233, 14, 88, 219, 25, 223, 195, 244, 90, 87, 239, 153, 137,
    255, 199, 147, 70, 92, 66, 246, 13, 216, 40, 62, 29, 217, 230, 86, 6,
    71, 24, 171, 196, 101, 113, 218, 123, 93, 91, 163, 178, 202, 67, 44, 235,
    107, 250, 75, 234, 49, 167, 125, 211, 83, 114, 157, 144, 32, 193, 143, 36,
    158, 124, 247, 187, 89, 214, 141, 47, 121, 228, 61, 130, 213, 194, 174, 251,
    97, 110, 54, 229, 115, 57, 152, 94, 105, 243, 212, 55, 209, 245, 63, 11,
    164, 200, 31, 156, 81, 176, 227, 21, 76, 99, 139, 188, 127, 17, 248, 51,
    207, 120, 189, 210, 8, 226, 41, 72, 183, 203, 135, 165, 166, 60, 98, 7,
    122, 38, 155, 170, 69, 172, 252, 238, 39, 134, 59, 128, 236, 27, 240, 80,
    131, 3, 85, 206, 145, 79, 154, 142, 159, 220, 201, 133, 74, 64, 20, 129,
    224, 185, 138, 103, 173, 182, 43, 34, 254, 82, 198, 151, 231, 180, 58, 10,
    118, 26, 102, 12, 50, 132, 22, 191, 136, 111, 162, 179, 45, 4, 148, 108,
    161, 56, 78, 126, 242, 222, 15, 175, 146, 23, 33, 241, 181, 190, 77, 225,
    0, 46, 169, 186, 68, 95, 237, 65, 53, 208, 253, 168, 9, 18, 100, 52,
    116, 184, 160, 96, 109, 37, 30, 106, 140, 104, 150, 5, 204, 117, 112, 84,
};

fun rol32(x: u32, n: u32) u32 {
    ret (x << n) | (x >> (32 - n));
}

fun subst(c: *Rar20, t: u32) u32 {
    ret c.table[(t & 0xFF)::usize]::u32 | (c.table[((t >> 8) & 0xFF)::usize]::u32 << 8) |
        (c.table[((t >> 16) & 0xFF)::usize]::u32 << 16) | (c.table[(t >> 24)::usize]::u32 << 24);
}

# run the 32 rounds over one block; `forward` encrypts (used while keying)
fun rounds(c: *Rar20, blk: *u8, forward: bool) {
    var a:  u32 = B.load_u32(?blk[0]) ^ c.key[0];
    var b:  u32 = B.load_u32(?blk[4]) ^ c.key[1];
    var cc: u32 = B.load_u32(?blk[8]) ^ c.key[2];
    var d:  u32 = B.load_u32(?blk[12]) ^ c.key[3];
    var r:  u32 = 0;
    for (r < 32) {
        var i: u32 = r;
        if (!forward) { i = 31 - r; }
        val ta: u32 = a ^ subst(c, (cc + rol32(d, 11)) ^ c.key[(i & 3)::usize]);
        val tb: u32 = b ^ subst(c, (d ^ rol32(cc, 17)) + c.key[(i & 3)::usize]);
        a  = cc;
        b  = d;
        cc = ta;
        d  = tb;
        r  = r + 1;
    }
    B.store_u32(?blk[0], cc ^ c.key[0]);
    B.store_u32(?blk[4], d ^ c.key[1]);
    B.store_u32(?blk[8], a ^ c.key[2]);
    B.store_u32(?blk[12], b ^ c.key[3]);
}

# fold 16 bytes into the keys through the CRC table
fun update_keys(c: *Rar20, blk: *u8) {
    var i: usize = 0;
    for (i < 16) {
        c.key[0] = c.key[0] ^ crc32.table_entry(blk[i]::u32);
        c.key[1] = c.key[1] ^ crc32.table_entry(blk[i + 1]::u32);
        c.key[2] = c.key[2] ^ crc32.table_entry(blk[i + 2]::u32);
        c.key[3] = c.key[3] ^ crc32.table_entry(blk[i + 3]::u32);
        i        = i + 4;
    }
}

pub fun rar20_init(c: *Rar20, pw: *u8, n0: usize) {
    var n: usize = n0;
    if (n > 127) { n = 127; }
    var buf: [128]u8;
    var i:   usize = 0;
    for (i < 128) {
        if (i < n) { buf[i] = pw[i]; }
        or         { buf[i] = 0; }
        i = i + 1;
    }
    c.key[0] = 0xD3A3B879;
    c.key[1] = 0x3F6D12F7;
    c.key[2] = 0x7515A235;
    c.key[3] = 0xA4E7F123;
    i        = 0;
    for (i < 256) {
        c.table[i] = SUBST[i];
        i          = i + 1;
    }
    # shuffle the table with the password
    var j: u32 = 0;
    for (j < 256) {
        i = 0;
        for (i < n) {
            var n1: u32 = crc32.table_entry((buf[i]::u32 - j) & 0xFF) & 0xFF;
            val n2: u32 = crc32.table_entry((buf[i + 1]::u32 + j) & 0xFF) & 0xFF;
            var k:  u32 = 1;
            for (n1 != n2) {
                val x: usize = n1::usize;
                val y: usize = ((n1 + i::u32 + k) & 0xFF)::usize;
                val t: u8    = c.table[x];
                c.table[x] = c.table[y];
                c.table[y] = t;
                n1         = (n1 + 1) & 0xFF;
                k          = k + 1;
            }
            i = i + 2;
        }
        j = j + 1;
    }
    # run the password itself through the cipher, folding it into the keys
    i = 0;
    for (i < n) {
        rounds(c, ?buf[i], true);
        update_keys(c, ?buf[i]);
        i = i + 16;
    }
}

# decrypt one 16-byte block in place
pub fun rar20_block(c: *Rar20, blk: *u8) {
    var cipher: [16]u8;
    var i:      usize = 0;
    for (i < 16) {
        cipher[i] = blk[i];
        i         = i + 1;
    }
    rounds(c, blk, false);
    update_keys(c, ?cipher[0]);
}
