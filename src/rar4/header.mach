# RAR 1.5-4.x block headers
#
# layout follows "RAR version 4.20 - Technical information" (technote.txt in
# the RAR 4.20 package, fetched by tests/get_rar4.sh; not redistributed).
# what that document leaves out was worked out from archives made by RAR
# 4.20 (tests/samples/rar4): the extended time record, the compact Unicode
# name encoding, the service (0x7a) and end-of-archive (0x7b) blocks.
#
# every header is turned into the RAR5 FileHeader record so the archive
# layer and the listing treat both formats alike.

use ramjet.crypto.crc32;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use B:  ramjet.bytes;
use LT: ramjet.localtime;
use M:  ramjet.mem;
use H:  ramjet.rar5.header;

pub val HEAD_MARK:    u8 = 0x72;
pub val HEAD_MAIN:    u8 = 0x73;
pub val HEAD_FILE:    u8 = 0x74;
pub val HEAD_COMMENT: u8 = 0x75;
pub val HEAD_AV:      u8 = 0x76;
pub val HEAD_SUB:     u8 = 0x77;
pub val HEAD_PROTECT: u8 = 0x78;
pub val HEAD_SIGN:    u8 = 0x79;
pub val HEAD_NEWSUB:  u8 = 0x7A;
pub val HEAD_END:     u8 = 0x7B;

# main header flags
pub val MHD_VOLUME:     u16 = 0x0001;
pub val MHD_COMMENT:    u16 = 0x0002;
pub val MHD_LOCK:       u16 = 0x0004;
pub val MHD_SOLID:      u16 = 0x0008;
pub val MHD_NEWNAMING:  u16 = 0x0010;
pub val MHD_PROTECT:    u16 = 0x0040;
pub val MHD_PASSWORD:   u16 = 0x0080;
pub val MHD_FIRSTVOL:   u16 = 0x0100;
pub val MHD_ENCRYPTVER: u16 = 0x0200;

# file header flags
pub val LHD_SPLIT_BEFORE: u16 = 0x0001;
pub val LHD_SPLIT_AFTER:  u16 = 0x0002;
pub val LHD_PASSWORD:     u16 = 0x0004;
pub val LHD_COMMENT:      u16 = 0x0008;
pub val LHD_SOLID:        u16 = 0x0010;
pub val LHD_DIRECTORY:    u16 = 0x00E0;
pub val LHD_LARGE:        u16 = 0x0100;
pub val LHD_UNICODE:      u16 = 0x0200;
pub val LHD_SALT:         u16 = 0x0400;
pub val LHD_VERSION:      u16 = 0x0800;
pub val LHD_EXTTIME:      u16 = 0x1000;
pub val LONG_BLOCK:       u16 = 0x8000;

# end of archive flags
pub val EARC_NEXT_VOLUME: u16 = 0x0001;

# host systems
pub val OS_MSDOS: u8 = 0;
pub val OS_OS2:   u8 = 1;
pub val OS_WIN32: u8 = 2;
pub val OS_UNIX:  u8 = 3;
pub val OS_MACOS: u8 = 4;
pub val OS_BEOS:  u8 = 5;

# the common 7-byte block prefix and the block's extent
# ---
# total:     header bytes (HEAD_SIZE)
# data_size: bytes after the header (ADD_SIZE / PACK_SIZE)
pub rec Block {
    crc:       u16;
    crc_ok:    bool;
    htype:     u8;
    flags:     u16;
    total:     usize;
    data_size: u64;
}

# parse the common prefix of the header at p
pub fun parse_block(p: *u8, avail: usize, out: *Block) bool {
    if (avail < 7) { ret false; }
    var c: B.Cursor = B.cursor(p, avail);
    out.crc   = B.read_u16(?c);
    out.htype = B.read_u8(?c);
    out.flags = B.read_u16(?c);
    out.total = B.read_u16(?c)::usize;
    if (out.total < 7 || out.total > avail) { ret false; }
    out.data_size = 0;
    if (out.htype == HEAD_FILE || out.htype == HEAD_NEWSUB) {
        if (out.total < 32) { ret false; }
        out.data_size = B.read_u32(?c)::u64;
        if ((out.flags & LHD_LARGE) != 0 && out.total >= 40) {
            # HIGH_PACK_SIZE sits after the fixed 32 bytes
            var hc: B.Cursor = B.cursor(?p[32], 4);
            out.data_size = out.data_size | (B.read_u32(?hc)::u64 << 32);
        }
    }
    or ((out.flags & LONG_BLOCK) != 0) {
        if (out.total < 11) { ret false; }
        out.data_size = B.read_u32(?c)::u64;
    }
    out.crc_ok = (crc32.hash(?p[2], out.total - 2) & 0xFFFF)::u16 == out.crc;
    ret true;
}

# ---------------------------------------------------------------- times

# MS-DOS date and time (local wall clock) to UTC
pub fun dos_time(t: u32) H.Time {
    val sec:   i64 = (2 * (t & 0x1F))::i64;
    val min:   i64 = ((t >> 5) & 0x3F)::i64;
    val hour:  i64 = ((t >> 11) & 0x1F)::i64;
    val day:   i64 = ((t >> 16) & 0x1F)::i64;
    val month: i64 = ((t >> 21) & 0x0F)::i64;
    val year:  i64 = ((t >> 25) & 0x7F)::i64 + 1980;
    val local: i64 = days(year, month, day) * 86400 + hour * 3600 + min * 60 + sec;
    ret H.Time{present: true, sec: LT.local_to_utc(local), nsec: 0};
}

fun days(y0: i64, m: i64, d: i64) i64 {
    var y: i64 = y0;
    if (m <= 2) { y = y - 1; }
    val era: i64 = y / 400;
    val yoe: i64 = y - era * 400;
    var mp:  i64 = m + 9;
    if (m > 2) { mp = m - 3; }
    val doy: i64 = (153 * mp + 2) / 5 + d - 1;
    ret era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468;
}

# extended time record: a 16-bit field with four 4-bit groups (mtime, ctime,
# atime, archive time from the top down): bit 3 present, bit 2 one second
# more, bits 0-1 how many bytes of 100 ns fraction follow (most significant
# kept). times other than mtime start with their own 4-byte DOS time.
fun read_exttime(c: *B.Cursor, out: *H.FileHeader, base_dos: u32) {
    val flags: u16 = B.read_u16(c);
    var i:     i64 = 3;
    for (i >= 0) {
        val mode: u16 = (flags >> (i * 4)::u16) & 0xF;
        if ((mode & 8) != 0) {
            var dos: u32 = base_dos;
            if (i != 3) { dos = B.read_u32(c); }
            var t:     H.Time = dos_time(dos);
            val count: u16    = mode & 3;
            var frac:  u32    = 0;
            var k:     u16    = 0;
            for (k < count) {
                frac = (B.read_u8(c)::u32 << 16) | (frac >> 8);
                k    = k + 1;
            }
            if ((mode & 4) != 0) { t.sec = t.sec + 1; }
            t.nsec = frac * 100;
            if (i == 3) { out.mtime = t; }
            or (i == 2) { out.ctime = t; }
            or (i == 1) { out.atime = t; }
        }
        i = i - 1;
    }
}

# ---------------------------------------------------------------- names

fun put_utf8(out: *u8, o: usize, cp: u32) usize {
    var n: usize = o;
    if (cp < 0x80) {
        out[n] = cp::u8;
        ret n + 1;
    }
    if (cp < 0x800) {
        out[n]     = (0xC0 | (cp >> 6))::u8;
        out[n + 1] = (0x80 | (cp & 0x3F))::u8;
        ret n + 2;
    }
    if (cp < 0x10000) {
        out[n]     = (0xE0 | (cp >> 12))::u8;
        out[n + 1] = (0x80 | ((cp >> 6) & 0x3F))::u8;
        out[n + 2] = (0x80 | (cp & 0x3F))::u8;
        ret n + 3;
    }
    out[n]     = (0xF0 | (cp >> 18))::u8;
    out[n + 1] = (0x80 | ((cp >> 12) & 0x3F))::u8;
    out[n + 2] = (0x80 | ((cp >> 6) & 0x3F))::u8;
    out[n + 3] = (0x80 | (cp & 0x3F))::u8;
    ret n + 4;
}

# decode the compact UTF-16 name that follows the byte name and its NUL
#
# a high byte comes first, then 2-bit opcodes packed four to a flag byte:
#   0: one byte, high byte 0        1: one byte, the stored high byte
#   2: two bytes, low then high     3: run copied from the byte name: a
#      length byte (bit 7: a correction byte follows, added to each copied
#      byte, and the stored high byte is used), length & 0x7F + 2 chars
fun decode_unicode(raw: *u8, n: usize, start: usize, units: *u16, max: usize) usize {
    var pos: usize = start;
    if (pos >= n) { ret 0; }
    val high: u8 = raw[pos];
    pos = pos + 1;
    var count: usize = 0;
    var flags: u8    = 0;
    var bits:  u32   = 0;
    for (pos < n && count < max) {
        if (bits == 0) {
            flags = raw[pos];
            pos   = pos + 1;
            bits  = 8;
            if (pos > n) { brk; }
        }
        bits = bits - 2;
        val op: u8 = (flags >> bits::u8) & 3;
        if (op == 0) {
            if (pos >= n) { brk; }
            units[count] = raw[pos]::u16;
            pos          = pos + 1;
            count        = count + 1;
        }
        or (op == 1) {
            if (pos >= n) { brk; }
            units[count] = raw[pos]::u16 | (high::u16 << 8);
            pos          = pos + 1;
            count        = count + 1;
        }
        or (op == 2) {
            if (pos + 1 >= n) { brk; }
            units[count] = raw[pos]::u16 | (raw[pos + 1]::u16 << 8);
            pos          = pos + 2;
            count        = count + 1;
        }
        or {
            if (pos >= n) { brk; }
            var len: u8 = raw[pos];
            pos = pos + 1;
            var correction: u8  = 0;
            var hi:         u16 = 0;
            if ((len & 0x80) != 0) {
                if (pos >= n) { brk; }
                correction = raw[pos];
                pos        = pos + 1;
                hi         = high::u16 << 8;
            }
            var k: usize = (len & 0x7F)::usize + 2;
            for (k > 0 && count < max) {
                val b: u8 = raw[count] + correction;
                units[count] = b::u16 | hi;
                count        = count + 1;
                k            = k - 1;
            }
        }
    }
    ret count;
}

# the archived name as NUL-terminated UTF-8 with '/' separators
fun decode_name(raw: *u8, n: usize, unicode: bool) *u8 {
    var zero: usize = 0;
    for (zero < n && raw[zero] != 0) { zero = zero + 1; }
    var out: *u8 = nil;
    if (unicode && zero < n) {
        val units: *u16 = M.alloc((n + 1) * 2)::*u16;
        if (units == nil) { ret nil; }
        val count: usize = decode_unicode(raw, n, zero + 1, units, n);
        out = M.alloc(count * 4 + 1);
        if (out == nil) { ret nil; }
        var o: usize = 0;
        var i: usize = 0;
        for (i < count) {
            var cp: u32 = units[i]::u32;
            if (cp >= 0xD800 && cp < 0xDC00 && i + 1 < count && units[i + 1]::u32 >= 0xDC00 && units[i + 1]::u32 < 0xE000) {
                cp = 0x10000 + ((cp - 0xD800) << 10) + (units[i + 1]::u32 - 0xDC00);
                i  = i + 1;
            }
            if (cp == 0) { brk; }
            o = put_utf8(out, o, cp);
            i = i + 1;
        }
        out[o] = 0;
        M.free(units::*u8, (n + 1) * 2);
    }
    or {
        # without a Unicode part the name is UTF-8 (flag set) or the
        # creator's code page; bytes are kept as they are
        out = M.dup(raw, zero);
        if (out == nil) { ret nil; }
    }
    var i: usize = 0;
    for (out[i] != 0) {
        if (out[i] == '\\') { out[i] = '/'; }
        i = i + 1;
    }
    ret out;
}

# ---------------------------------------------------------------- file header

# parse a file (0x74) or service (0x7a) header
# ---
# p:   the header (block prefix included)
# out: the RAR5-shaped record; name points at a fresh allocation
# ret: false when the header is malformed
pub fun parse_file(p: *u8, b: *Block, out: *H.FileHeader) bool {
    var c: B.Cursor = B.cursor(p, b.total);
    B.skip(?c, 7);
    var pack_lo: u32 = B.read_u32(?c);
    var unp_lo:  u32 = B.read_u32(?c);
    val host:    u8  = B.read_u8(?c);
    out.data_crc = B.read_u32(?c);
    val ftime: u32 = B.read_u32(?c);
    out.unp_ver = B.read_u8(?c);
    val method:   u8    = B.read_u8(?c);
    val name_len: usize = B.read_u16(?c)::usize;
    out.attr = B.read_u32(?c)::u64;
    var unp: u64 = unp_lo::u64;
    if ((b.flags & LHD_LARGE) != 0) {
        B.read_u32(?c);
        unp = unp | (B.read_u32(?c)::u64 << 32);
    }
    if (c.bad || name_len > B.remaining(?c)) { ret false; }
    pack_lo = pack_lo;
    val raw: *u8 = B.here(?c);
    B.skip(?c, name_len::u64);

    out.rar4  = true;
    out.flags = H.FHFL_CRC32;
    if ((b.flags & LHD_DIRECTORY) == LHD_DIRECTORY && b.htype == HEAD_FILE) { out.flags = out.flags | H.FHFL_DIRECTORY; }
    out.unp_size      = unp;
    out.mtime         = dos_time(ftime);
    out.ctime.present = false;
    out.atime.present = false;
    out.comp_info     = 0;
    out.comp_version  = 0;
    out.method        = 0;
    if (method >= 0x30 && method <= 0x35) { out.method = (method - 0x30)::u64; }
    out.solid     = (b.flags & LHD_SOLID) != 0 && b.htype == HEAD_FILE;
    out.dict_size = 0x10000::u64 << ((b.flags >> 5) & 7)::u64;
    out.v1_as_v0  = false;
    out.host_os   = H.HOST_WINDOWS;
    if (host == OS_UNIX || host == OS_BEOS) { out.host_os = H.HOST_UNIX; }

    if (b.htype == HEAD_NEWSUB) {
        out.name = M.dup(raw, name_len);
    }
    or {
        out.name = decode_name(raw, name_len, (b.flags & LHD_UNICODE) != 0);
    }
    if (out.name == nil) { ret false; }
    out.name_len = M.cstr_len(out.name);

    out.crypt.present   = (b.flags & LHD_PASSWORD) != 0;
    out.crypt.rar4      = true;
    out.crypt.version   = out.unp_ver::u64;
    out.crypt.flags     = 0;
    out.crypt.kdf_count = 0;
    var i: usize = 0;
    for (i < 16) {
        out.crypt.salt[i] = 0;
        i                 = i + 1;
    }
    if ((b.flags & LHD_SALT) != 0)                            { B.read_into(?c, ?out.crypt.salt[0], 8); }
    if ((b.flags & LHD_EXTTIME) != 0 && B.remaining(?c) >= 2) { read_exttime(?c, out, ftime); }

    out.has_blake2   = false;
    out.file_version = 0;
    out.redir_type   = H.REDIR_NONE;
    out.redir_flags  = 0;
    out.redir_name   = nil;
    out.redir_len    = 0;
    out.has_uid      = false;
    out.has_gid      = false;
    out.uid          = 0;
    out.gid          = 0;
    out.user_name    = nil;
    out.user_len     = 0;
    out.group_name   = nil;
    out.group_len    = 0;
    out.subdata      = nil;
    out.subdata_len  = 0;

    # an older version (-ver) carries ";n" at the end of its name
    if ((b.flags & LHD_VERSION) != 0) {
        var k:   usize = out.name_len;
        var v:   u64   = 0;
        var mul: u64   = 1;
        for (k > 0 && out.name[k - 1] >= '0' && out.name[k - 1] <= '9') {
            v   = v + (out.name[k - 1] - '0')::u64 * mul;
            mul = mul * 10;
            k   = k - 1;
        }
        if (k > 0 && out.name[k - 1] == ';') {
            out.file_version = v;
            out.name[k - 1]  = 0;
            out.name_len     = k - 1;
        }
    }
    ret !c.bad;
}

# the main header's flags
pub fun parse_main(p: *u8, b: *Block) u16 {
    ret b.flags;
}

# the end block's flags
pub fun parse_end(p: *u8, b: *Block) u16 {
    ret b.flags;
}

test rar4_header__unicode_name {
    # "ab" followed by the encoding of U+0105 U+0062: high byte 0x01,
    # flags 0b01_00_0000 (op 1 then op 0), bytes 0x05, 0x62
    var raw: [8]u8;
    raw[0] = 'a';
    raw[1] = 'b';
    raw[2] = 0;
    raw[3] = 0x01;
    raw[4] = 0x40;
    raw[5] = 0x05;
    raw[6] = 0x62;
    val name: *u8 = decode_name(?raw[0], 7, true);
    # U+0105 is C4 85 in UTF-8
    if (name[0] != 0xC4 || name[1] != 0x85 || name[2] != 'b' || name[3] != 0) { ret 1; }
    ret 0;
}

test rar4_header__dos_time_fields {
    # 2001-02-03 04:05:06 as DOS fields; checked against local_to_utc
    val t:   u32    = ((2001 - 1980)::u32 << 25) | (2::u32 << 21) | (3::u32 << 16) | (4::u32 << 11) | (5::u32 << 5) | 3;
    val got: H.Time = dos_time(t);
    if (got.sec != LT.local_to_utc(981173106)) { ret 1; }
    ret 0;
}
