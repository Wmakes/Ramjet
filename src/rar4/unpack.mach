# RAR 2.9 decompression (unpack version 29, written by RAR 3.x and 4.x)
#
# one continuous bit stream per file. a table block starts with a bit that
# selects PPMd or LZ:
#
#   LZ:   a "keep previous lengths" bit, 20 four-bit lengths for the code
#         length code (15 = escape: 0 means 15, n means n+2 zeros), then 404
#         lengths for the main (299), distance (60), low distance (17) and
#         repeat length (28) codes, coded as deltas (mod 16) to the previous
#         lengths, with 16/17 repeating the previous length and 18/19 zeros
#   PPMd: 7 flag bits, optional memory size and escape byte, then the range
#         coded symbols; the escape byte introduces LZ commands
#
# main symbols: 0-255 literal, 256 end of block (new tables, or end of file),
# 257 a filter, 258 repeat the last match, 259-262 one of four old distances,
# 263-270 short distance with length 2, 271-298 a new match.
#
# filters are RAR VM programs; archives made by RAR only use a fixed set of
# standard programs, recognized here by fingerprint (CRC32 and length of the
# program) and run natively. any other program is refused rather than run.

use ramjet.crypto.crc32;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use B:  ramjet.bytes;
use E:  ramjet.errors;
use HF: ramjet.huffman;
use M:  ramjet.mem;
use BI: ramjet.rar4.bitin;
use PM: ramjet.rar4.ppmd;
use S:  ramjet.stream;

val NC:     usize = 299;
val DC:     usize = 60;
val LDC:    usize = 17;
val RC:     usize = 28;
val BC:     usize = 20;
val TABLES: usize = 404;

val WINDOW:    u64 = 0x400000;
val MAX_MATCH: u64 = 0x200;

val VM_MEMORY:      usize = 0x40000;
val VM_WORK:        usize = 0x3C000;
val VM_GLOBAL:      u32   = 0x3C000;
val VM_USER_GLOBAL: usize = 0x2000 - 0x40;
val MAX_FILTERS:    usize = 1024;
val MAX_PROGRAMS:   usize = 1024;

# standard VM programs: CRC32 | length << 32 of the program bytes
val FP_DELTA: u64 = 0x1D0E06077D;
val FP_E8:    u64 = 0x35AD576887;
val FP_E8E9:  u64 = 0x393CD7E57E;
val FP_RGB:   u64 = 0x951C2C5DC8;
val FP_AUDIO: u64 = 0xD8BC85E701;
# found by running the filter_itanium sample; see docs/clean-room-notes.md
val FP_ITANIUM: u64 = 0x783769893F;

rec Program {
    fingerprint: u64;
    old_len:     u32;
    usage:       u32;
}

rec Filter {
    start: u64;
    len:   u32;
    prog:  usize;
    regs:  [7]u32;
}

pub rec Unpacker {
    window:     *u8;
    pos:        u64;
    flushed:    u64;
    file_start: u64;
    file_end:   u64;

    lengths:     [404]u8;
    ld:          HF.Huff;
    dd:          HF.Huff;
    ldd:         HF.Huff;
    rd:          HF.Huff;
    bd:          HF.Huff;
    tables_read: bool;

    old_dist:  [4]u64;
    last_dist: u64;
    last_len:  u64;
    low_rep:   u32;
    last_low:  u64;

    ppm:       bool;
    ppm_esc:   u32;
    ppm_ready: bool;
    model:     PM.Model;

    progs:     *Program;
    nprogs:    usize;
    last_prog: usize;
    filters:   *Filter;
    nfilters:  usize;
    vm:        *u8;
    # filter code being read; kept here so the per-symbol functions that
    # might read one do not carry a 64 KB stack frame
    code: *u8;

    bi:     BI.BitIn;
    ended:  bool;
    broken: bool;
}

pub fun init(u: *Unpacker) {
    u.window  = nil;
    u.progs   = nil;
    u.filters = nil;
    u.vm      = nil;
    u.code    = nil;
    u.bi.buf  = nil;
    PM.construct(?u.model);
    u.ppm_ready = false;
    u.broken    = false;
    reset(u);
}

fun reset(u: *Unpacker) {
    u.pos     = 0;
    u.flushed = 0;
    var i: usize = 0;
    for (i < TABLES) {
        u.lengths[i] = 0;
        i            = i + 1;
    }
    u.tables_read = false;
    u.old_dist[0] = 0;
    u.old_dist[1] = 0;
    u.old_dist[2] = 0;
    u.old_dist[3] = 0;
    u.last_dist   = 0;
    u.last_len    = 0;
    u.low_rep     = 0;
    u.last_low    = 0;
    u.ppm         = false;
    u.ppm_esc     = 2;
    u.nprogs      = 0;
    u.last_prog   = 0;
    u.nfilters    = 0;
}

pub fun dnit(u: *Unpacker) {
    if (u.window != nil)  { M.free(u.window, WINDOW::usize); }
    if (u.progs != nil)   { M.free(u.progs::*u8, MAX_PROGRAMS * $size_of(Program)); }
    if (u.filters != nil) { M.free(u.filters::*u8, MAX_FILTERS * $size_of(Filter)); }
    if (u.vm != nil)      { M.free(u.vm, VM_MEMORY + 8); }
    if (u.code != nil)    { M.free(u.code, 0x10000); }
    u.code = nil;
    PM.free(?u.model);
    BI.dnit(?u.bi);
    u.window  = nil;
    u.progs   = nil;
    u.filters = nil;
    u.vm      = nil;
}

# ---------------------------------------------------------------- tables

#[inline]
fun decode(u: *Unpacker, h: *HF.Huff) u32 {
    val r: u32 = HF.lookup(h, BI.peek16(?u.bi));
    BI.skip(?u.bi, r >> 16);
    ret r & 0xFFFF;
}

fun read_lz_tables(u: *Unpacker) bool {
    if (BI.bits(?u.bi, 1) == 0) {
        var i: usize = 0;
        for (i < TABLES) {
            u.lengths[i] = 0;
            i            = i + 1;
        }
    }
    var bl: [20]u8;
    var i:  usize = 0;
    for (i < BC) {
        val v: u8 = BI.bits(?u.bi, 4)::u8;
        if (v == 15) {
            val z: u8 = BI.bits(?u.bi, 4)::u8;
            if (z == 0) {
                bl[i] = 15;
                i     = i + 1;
            }
            or {
                var k: usize = 0;
                for (k < z::usize + 2 && i < BC) {
                    bl[i] = 0;
                    i     = i + 1;
                    k     = k + 1;
                }
            }
        }
        or {
            bl[i] = v;
            i     = i + 1;
        }
    }
    if (!HF.build(?u.bd, ?bl[0], BC)) { ret false; }

    i = 0;
    for (i < TABLES) {
        if (BI.exhausted(?u.bi)) { ret false; }
        val s: u32 = decode(u, ?u.bd);
        if (s < 16) {
            u.lengths[i] = ((u.lengths[i]::u32 + s) & 15)::u8;
            i            = i + 1;
        }
        or (s == 16 || s == 17) {
            if (i == 0) { ret false; }
            var n: u32 = 0;
            if (s == 16) { n = BI.bits(?u.bi, 3) + 3; }
            or           { n = BI.bits(?u.bi, 7) + 11; }
            for (n > 0 && i < TABLES) {
                u.lengths[i] = u.lengths[i - 1];
                i            = i + 1;
                n            = n - 1;
            }
        }
        or (s == 18 || s == 19) {
            var n: u32 = 0;
            if (s == 18) { n = BI.bits(?u.bi, 3) + 3; }
            or           { n = BI.bits(?u.bi, 7) + 11; }
            for (n > 0 && i < TABLES) {
                u.lengths[i] = 0;
                i            = i + 1;
                n            = n - 1;
            }
        }
        or {
            ret false;
        }
    }
    if (!HF.build(?u.ld, ?u.lengths[0], NC))             { ret false; }
    if (!HF.build(?u.dd, ?u.lengths[NC], DC))            { ret false; }
    if (!HF.build(?u.ldd, ?u.lengths[NC + DC], LDC))     { ret false; }
    if (!HF.build(?u.rd, ?u.lengths[NC + DC + LDC], RC)) { ret false; }
    ret true;
}

fun read_ppm_header(u: *Unpacker) bool {
    val flags: u32 = BI.bits(?u.bi, 7);
    var mem:   u32 = 0;
    if ((flags & 0x20) != 0) { mem = (BI.bits(?u.bi, 8) + 1) << 20; }
    # the escape byte is kept from the previous PPMd block unless given
    if ((flags & 0x40) != 0) {
        u.ppm_esc = BI.bits(?u.bi, 8);
        PM.set_init_esc(?u.model, u.ppm_esc);
    }
    if ((flags & 0x20) != 0) {
        var order: u32 = (flags & 0x1F) + 1;
        if (order > 16)                      { order = 16 + (order - 16) * 3; }
        if (order == 1)                      { ret false; }
        if (!PM.alloc(?u.model, mem))        { ret false; }
        if (!PM.range_init(?u.model, ?u.bi)) { ret false; }
        PM.init(?u.model, order);
        u.ppm_ready = true;
    }
    or {
        if (!u.ppm_ready)                    { ret false; }
        if (!PM.range_init(?u.model, ?u.bi)) { ret false; }
    }
    ret true;
}

# a table block: byte aligned, PPMd or LZ
fun read_tables(u: *Unpacker) bool {
    BI.align(?u.bi);
    if (BI.bits(?u.bi, 1) != 0) {
        u.ppm = true;
        if (!read_ppm_header(u)) { ret false; }
    }
    or {
        u.ppm      = false;
        u.low_rep  = 0;
        u.last_low = 0;
        if (!read_lz_tables(u)) { ret false; }
    }
    u.tables_read = true;
    ret true;
}

# ---------------------------------------------------------------- output

#[inline]
fun put(u: *Unpacker, b: u8) {
    u.window[(u.pos & (WINDOW - 1))::usize] = b;
    u.pos                                   = u.pos + 1;
}

#[inline]
fun copy_match(u: *Unpacker, len: u64, dist: u64) {
    val mask: u64 = WINDOW - 1;
    val w:    *u8 = u.window;
    val d:    u64 = u.pos & mask;
    val sidx: u64 = (u.pos - dist) & mask;
    if (dist >= 8 && dist <= u.pos && d + len + 8 <= WINDOW && sidx + len + 8 <= WINDOW) {
        M.lz_copy8(?w[d::usize], ?w[sidx::usize], len::usize);
        u.pos = u.pos + len;
        ret;
    }
    var n: u64 = 0;
    for (n < len) {
        w[((u.pos + n) & mask)::usize] = w[((u.pos + n - dist) & mask)::usize];
        n                              = n + 1;
    }
    u.pos = u.pos + len;
}

fun emit(u: *Unpacker, sink: *S.Sink, from: u64, to: u64) {
    var a: u64 = from;
    var b: u64 = to;
    if (b > u.file_end) { b = u.file_end; }
    for (a < b) {
        val off: u64 = a & (WINDOW - 1);
        var n:   u64 = b - a;
        if (n > WINDOW - off) { n = WINDOW - off; }
        S.sink_write(sink, ?u.window[off::usize], n::usize);
        a = a + n;
    }
}

fun emit_bytes(u: *Unpacker, sink: *S.Sink, at: u64, p: *u8, n: u64) {
    var keep: u64 = n;
    if (at >= u.file_end)       { ret; }
    if (at + keep > u.file_end) { keep = u.file_end - at; }
    S.sink_write(sink, p, keep::usize);
}

# ---------------------------------------------------------------- filters

# a RAR VM number: 2 bits select 4 bits, 8 bits (with a negative form), 16
# or 32 bits
fun vm_number(c: *BitReader) u32 {
    val kind: u32 = read_bits(c, 2);
    if (kind == 0) { ret read_bits(c, 4); }
    if (kind == 1) {
        val v: u32 = read_bits(c, 8);
        if (v >= 16) { ret v; }
        ret 0xFFFFFF00 | (v << 4) | read_bits(c, 4);
    }
    if (kind == 2) { ret read_bits(c, 16); }
    ret read_bits(c, 32);
}

# MSB-first reader over a filter's own bytes
rec BitReader {
    p:   *u8;
    n:   usize;
    pos: u64;
    bad: bool;
}

fun read_bits(c: *BitReader, count: u32) u32 {
    var v: u32 = 0;
    var i: u32 = 0;
    for (i < count) {
        val byte: usize = (c.pos >> 3)::usize;
        if (byte >= c.n) {
            c.bad = true;
            ret 0;
        }
        val bit: u32 = (c.p[byte]::u32 >> (7 - (c.pos & 7))::u32) & 1;
        v     = (v << 1) | bit;
        c.pos = c.pos + 1;
        i     = i + 1;
    }
    ret v;
}

fun parse_filter(u: *Unpacker, code: *u8, len: usize, flags: u8) E.Code {
    if (u.progs == nil) {
        u.progs   = M.alloc(MAX_PROGRAMS * $size_of(Program))::*Program;
        u.filters = M.alloc(MAX_FILTERS * $size_of(Filter))::*Filter;
        u.vm      = M.alloc(VM_MEMORY + 8);
        if (u.progs == nil || u.filters == nil || u.vm == nil) { ret E.NO_MEMORY; }
    }
    var c: BitReader = BitReader{p: code, n: len, pos: 0, bad: false};

    var num: usize = u.last_prog;
    if ((flags & 0x80) != 0) {
        var n: u32 = vm_number(?c);
        if (n == 0) {
            # forget every program and pending filter
            u.nprogs   = 0;
            u.nfilters = 0;
        }
        or {
            n = n - 1;
        }
        if (n::usize > u.nprogs) { ret E.BAD_DATA; }
        num         = n::usize;
        u.last_prog = num;
    }
    val is_new: bool = num == u.nprogs;
    if (!is_new) { u.progs[num].usage = u.progs[num].usage + 1; }

    var start: u64 = vm_number(?c)::u64 + u.pos;
    if ((flags & 0x40) != 0) { start = start + 258; }
    var blen: u32 = 0;
    if ((flags & 0x20) != 0) {
        blen = vm_number(?c);
    }
    or (!is_new) {
        blen = u.progs[num].old_len;
    }
    if (blen::usize > VM_WORK) { ret E.BAD_DATA; }

    var regs: [7]u32;
    var i:    usize = 0;
    for (i < 7) {
        regs[i] = 0;
        i       = i + 1;
    }
    regs[3] = VM_GLOBAL;
    regs[4] = blen;
    if (!is_new) { regs[5] = u.progs[num].usage; }
    if ((flags & 0x10) != 0) {
        val mask: u32 = read_bits(?c, 7);
        i = 0;
        for (i < 7) {
            if ((mask & (1::u32 << i::u32)) != 0) { regs[i] = vm_number(?c); }
            i = i + 1;
        }
    }

    if (is_new) {
        val plen: u32 = vm_number(?c);
        if (plen == 0 || plen > 0x10000 || u.nprogs == MAX_PROGRAMS) { ret E.BAD_DATA; }
        val bytes: *u8 = M.alloc(plen::usize);
        if (bytes == nil) { ret E.NO_MEMORY; }
        i = 0;
        for (i < plen::usize) {
            bytes[i] = read_bits(?c, 8)::u8;
            i        = i + 1;
        }
        # the first program byte is the XOR of the others
        var x: u8 = 0;
        i = 1;
        for (i < plen::usize) {
            x = x ^ bytes[i];
            i = i + 1;
        }
        val fp: u64  = crc32.hash(bytes, plen::usize)::u64 | (plen::u64 << 32);
        val ok: bool = x == bytes[0];
        M.free(bytes, plen::usize);
        if (!ok) { ret E.BAD_DATA; }
        u.progs[num] = Program{fingerprint: fp, old_len: 0, usage: 0};
        u.nprogs     = u.nprogs + 1;
    }
    u.progs[num].old_len = blen;

    if ((flags & 0x08) != 0) {
        # user global data is only read by real VM programs; skip it
        val glen: u32 = vm_number(?c);
        if (glen::usize > VM_USER_GLOBAL) { ret E.BAD_DATA; }
        i = 0;
        for (i < glen::usize) {
            read_bits(?c, 8);
            i = i + 1;
        }
    }
    if (c.bad)                     { ret E.BAD_DATA; }
    if (u.nfilters == MAX_FILTERS) { ret E.BAD_DATA; }
    var f: Filter;
    f.start = start;
    f.len   = blen;
    f.prog  = num;
    i       = 0;
    for (i < 7) {
        f.regs[i] = regs[i];
        i         = i + 1;
    }
    u.filters[u.nfilters] = f;
    u.nfilters            = u.nfilters + 1;
    ret E.OK;
}

fun filter_buffer(u: *Unpacker) bool {
    if (u.code == nil) { u.code = M.alloc(0x10000); }
    ret u.code != nil;
}

# the filter code bytes: a flags byte whose low 3 bits give the length
# (7: one more byte + 7, 8: two more bytes), then the bytes
fun read_filter_lz(u: *Unpacker) E.Code {
    val flags: u8    = BI.bits(?u.bi, 8)::u8;
    var len:   usize = (flags & 7)::usize + 1;
    if (len == 7)          { len = BI.bits(?u.bi, 8)::usize + 7; }
    or (len == 8)          { len = BI.bits(?u.bi, 16)::usize; }
    if (!filter_buffer(u)) { ret E.NO_MEMORY; }
    val code: *u8   = u.code;
    var i:    usize = 0;
    for (i < len) {
        code[i] = BI.bits(?u.bi, 8)::u8;
        i       = i + 1;
    }
    ret parse_filter(u, code, len, flags);
}

fun ppm_byte(u: *Unpacker, ok: *bool) u8 {
    val c: i32 = PM.decode_symbol(?u.model);
    if (c < 0) {
        @ok = false;
        ret 0;
    }
    ret c::u8;
}

fun read_filter_ppm(u: *Unpacker) E.Code {
    var ok:    bool  = true;
    val flags: u8    = ppm_byte(u, ?ok);
    var len:   usize = (flags & 7)::usize + 1;
    if (len == 7) { len = ppm_byte(u, ?ok)::usize + 7; }
    or (len == 8) {
        len = ppm_byte(u, ?ok)::usize << 8;
        len = len | ppm_byte(u, ?ok)::usize;
    }
    if (!filter_buffer(u)) { ret E.NO_MEMORY; }
    val code: *u8   = u.code;
    var i:    usize = 0;
    for (i < len) {
        code[i] = ppm_byte(u, ?ok);
        i       = i + 1;
    }
    if (!ok) { ret E.BAD_DATA; }
    ret parse_filter(u, code, len, flags);
}

# ---- the standard filters, each over vm[0..len) with registers r0..r6

fun run_delta(vm: *u8, len: u32, channels: u32, out_at: *u32) bool {
    if (len::usize > VM_WORK / 2 || channels == 0 || channels > 128) { ret false; }
    var src: u32 = 0;
    var c:   u32 = 0;
    for (c < channels) {
        var prev: u8  = 0;
        var d:    u32 = c;
        for (d < len) {
            prev                 = prev - vm[src::usize];
            vm[(len + d)::usize] = prev;
            src                  = src + 1;
            d                    = d + channels;
        }
        c = c + 1;
    }
    @out_at = len;
    ret true;
}

fun run_e8(vm: *u8, len: u32, file_pos: u64, e9: bool) bool {
    if (len::usize > VM_WORK || len <= 4) { ret false; }
    val fsize: u32 = 0x1000000;
    var i:     u32 = 0;
    for (i + 5 <= len) {
        val op: u8 = vm[i::usize];
        if (op == 0xE8 || (e9 && op == 0xE9)) {
            val cur:  u32 = (file_pos + i::u64 + 1)::u32;
            val addr: u32 = B.load_u32(?vm[(i + 1)::usize]);
            if ((addr & 0x80000000) != 0) {
                # negative: absolute target before this position
                if (cur >= (0 - addr)) { B.store_u32(?vm[(i + 1)::usize], addr + fsize); }
            }
            or (addr < fsize) {
                B.store_u32(?vm[(i + 1)::usize], addr - cur);
            }
            i = i + 4;
        }
        i = i + 1;
    }
    ret true;
}

fun abs_diff(v: i32) u32 {
    if (v < 0) { ret (0 - v)::u32; }
    ret v::u32;
}

fun run_rgb(vm: *u8, len: u32, stride: u32, byte_off: u32, out_at: *u32) bool {
    if (len::usize > VM_WORK / 2 || stride > len || len < 3 || byte_off > 2) { ret false; }
    val dst: u32 = len;
    var src: u32 = 0;
    var c:   u32 = 0;
    for (c < 3) {
        var b: u8  = 0;
        var j: u32 = c;
        for (j < len) {
            # predict from the pixel above (stride back) and its neighbor
            if (j >= stride) {
                val prev:        u32 = dst + j - stride;
                val above:       i32 = vm[prev::usize]::i32;
                val above_right: i32 = vm[(prev + 3)::usize]::i32;
                val d1:          u32 = abs_diff(above_right - above);
                val d2:          u32 = abs_diff(b::i32 - above);
                val d3:          u32 = abs_diff(above_right - above + b::i32 - above);
                if (d1 > d2 || d1 > d3) {
                    if (d2 <= d3) { b = above_right::u8; }
                    or            { b = above::u8; }
                }
            }
            b                    = b - vm[src::usize];
            src                  = src + 1;
            vm[(dst + j)::usize] = b;
            j                    = j + 3;
        }
        c = c + 1;
    }
    var i: u32 = byte_off;
    for (i + 2 < len) {
        vm[(dst + i)::usize]     = vm[(dst + i)::usize] + vm[(dst + i + 1)::usize];
        vm[(dst + i + 2)::usize] = vm[(dst + i + 2)::usize] + vm[(dst + i + 1)::usize];
        i                        = i + 3;
    }
    @out_at = len;
    ret true;
}

fun run_audio(vm: *u8, len: u32, channels: u32, out_at: *u32) bool {
    if (len::usize > VM_WORK / 2 || channels == 0 || channels > 128) { ret false; }
    var src: u32 = 0;
    var c:   u32 = 0;
    for (c < channels) {
        # adaptive linear predictor over the last deltas
        var last_byte:  u32   = 0;
        var last_delta: i32   = 0;
        var d0:         i32   = 0;
        var d1:         i32   = 0;
        var d2:         i32   = 0;
        var w0:         i32   = 0;
        var w1:         i32   = 0;
        var w2:         i32   = 0;
        var err:        [7]u32;
        var k:          usize = 0;
        for (k < 7) {
            err[k] = 0;
            k      = k + 1;
        }
        var count: u32 = 0;
        var j:     u32 = c;
        for (j < len) {
            val delta: i32 = vm[src::usize]::i8::i32;
            src = src + 1;
            d2  = d1;
            d1  = last_delta - d0;
            d0  = last_delta;
            val pred: u32 = ((8 * last_byte::i32 + w0 * d0 + w1 * d1 + w2 * d2) >> 3)::u32 & 0xFF;
            val byte: u32 = (pred - delta::u32) & 0xFF;
            val pe:   i32 = delta * 8;
            err[0]               = err[0] + abs_diff(pe);
            err[1]               = err[1] + abs_diff(pe - d0);
            err[2]               = err[2] + abs_diff(pe + d0);
            err[3]               = err[3] + abs_diff(pe - d1);
            err[4]               = err[4] + abs_diff(pe + d1);
            err[5]               = err[5] + abs_diff(pe - d2);
            err[6]               = err[6] + abs_diff(pe + d2);
            last_delta           = (byte - last_byte)::u8::i8::i32;
            last_byte            = byte;
            vm[(len + j)::usize] = byte::u8;
            if ((count & 0x1F) == 0) {
                var best: usize = 0;
                k = 1;
                for (k < 7) {
                    if (err[k] < err[best]) { best = k; }
                    k = k + 1;
                }
                k = 0;
                for (k < 7) {
                    err[k] = 0;
                    k      = k + 1;
                }
                if (best == 1 && w0 >= -16) { w0 = w0 - 1; }
                or (best == 2 && w0 < 16)   { w0 = w0 + 1; }
                or (best == 3 && w1 >= -16) { w1 = w1 - 1; }
                or (best == 4 && w1 < 16)   { w1 = w1 + 1; }
                or (best == 5 && w2 >= -16) { w2 = w2 - 1; }
                or (best == 6 && w2 < 16)   { w2 = w2 + 1; }
            }
            count = count + 1;
            j     = j + channels;
        }
        c = c + 1;
    }
    @out_at = len;
    ret true;
}

# IA-64 bundles are 16 bytes: a 5-bit template and three 41-bit slots. for
# templates with branch slots, an IP-relative 20-bit target in a slot whose
# opcode (bits 37-40) is 5 was made absolute (in 16-byte units).
fun ia64_bits(p: *u8, at: u32, n: u32) u32 {
    var v: u32 = 0;
    var i: u32 = 0;
    for (i < n) {
        val bit: u32 = at + i;
        v = v | ((p[(bit >> 3)::usize]::u32 >> (bit & 7)) & 1) << i;
        i = i + 1;
    }
    ret v;
}

fun ia64_set(p: *u8, at: u32, n: u32, v: u32) {
    var i: u32 = 0;
    for (i < n) {
        val bit: u32   = at + i;
        val idx: usize = (bit >> 3)::usize;
        val m:   u8    = (1::u32 << (bit & 7))::u8;
        if (((v >> i) & 1) != 0) { p[idx] = p[idx] | m; }
        or                       { p[idx] = p[idx] & ~m; }
        i = i + 1;
    }
}

fun run_itanium(vm: *u8, len: u32, file_pos: u64) bool {
    if (len::usize > VM_WORK) { ret false; }
    val masks:  [16]u8 = [16]u8{4, 4, 6, 6, 0, 0, 7, 7, 4, 4, 0, 0, 4, 4, 0, 0};
    var bundle: u32    = (file_pos >> 4)::u32;
    var at:     u32    = 0;
    for (at + 21 < len) {
        val p:    *u8 = ?vm[at::usize];
        val tmpl: i32 = (p[0] & 0x1F)::i32 - 0x10;
        if (tmpl >= 0) {
            val cmask: u8  = masks[tmpl::usize];
            var slot:  u32 = 0;
            for (slot <= 2) {
                if ((cmask & (1::u32 << slot)::u8) != 0) {
                    val base: u32 = slot * 41 + 5;
                    if (ia64_bits(p, base + 37, 4) == 5) {
                        val target: u32 = ia64_bits(p, base + 13, 20);
                        ia64_set(p, base + 13, 20, (target - bundle) & 0xFFFFF);
                    }
                }
                slot = slot + 1;
            }
        }
        at     = at + 16;
        bundle = bundle + 1;
    }
    ret true;
}

# run one filter on vm[0..len); the result is at vm[out_at..out_at+len)
fun run_program(u: *Unpacker, f: *Filter, out_at: *u32) E.Code {
    val fp:       u64 = u.progs[f.prog].fingerprint;
    val len:      u32 = f.len;
    val file_pos: u64 = f.start - u.file_start;
    @out_at = 0;
    var ok: bool = false;
    if (fp == FP_DELTA)   { ok = run_delta(u.vm, len, f.regs[0], out_at); }
    or (fp == FP_E8)      { ok = run_e8(u.vm, len, file_pos, false); }
    or (fp == FP_E8E9)    { ok = run_e8(u.vm, len, file_pos, true); }
    or (fp == FP_RGB)     { ok = run_rgb(u.vm, len, f.regs[0], f.regs[1], out_at); }
    or (fp == FP_AUDIO)   { ok = run_audio(u.vm, len, f.regs[0], out_at); }
    or (fp == FP_ITANIUM) { ok = run_itanium(u.vm, len, file_pos); }
    or {
        print.eprintf("ramjet: unknown RAR VM program {:x}\n", fp);
        ret E.UNSUPPORTED;
    }
    if (!ok) { ret E.BAD_DATA; }
    ret E.OK;
}

fun pop_filter(u: *Unpacker) {
    var i: usize = 1;
    for (i < u.nfilters) {
        u.filters[i - 1] = u.filters[i];
        i                = i + 1;
    }
    u.nfilters = u.nfilters - 1;
}

# send everything final, running filters whose range is complete
fun flush(u: *Unpacker, sink: *S.Sink) E.Code {
    for {
        if (u.nfilters == 0) {
            emit(u, sink, u.flushed, u.pos);
            u.flushed = u.pos;
            ret E.OK;
        }
        val f: *Filter = ?u.filters[0];
        if (u.flushed < f.start) {
            var upto: u64 = f.start;
            if (upto > u.pos) { upto = u.pos; }
            emit(u, sink, u.flushed, upto);
            u.flushed = upto;
            if (u.flushed < f.start) { ret E.OK; }
        }
        if (u.flushed > f.start)          { ret E.BAD_DATA; }
        if (u.pos < f.start + f.len::u64) { ret E.OK; }

        # window range into VM memory
        var i: u32 = 0;
        for (i < f.len) {
            u.vm[i::usize] = u.window[((f.start + i::u64) & (WINDOW - 1))::usize];
            i              = i + 1;
        }
        val start:   u64    = f.start;
        var out_at:  u32    = 0;
        var out_len: u32    = f.len;
        val rc:      E.Code = run_program(u, f, ?out_at);
        if (rc != E.OK) { ret rc; }
        pop_filter(u);
        # filters stacked on the same range run on the previous output
        for (u.nfilters > 0 && u.filters[0].start == start && u.filters[0].len == out_len) {
            M.move(u.vm, ?u.vm[out_at::usize], out_len::usize);
            val rc2: E.Code = run_program(u, ?u.filters[0], ?out_at);
            if (rc2 != E.OK) { ret rc2; }
            out_len = u.filters[0].len;
            pop_filter(u);
        }
        emit_bytes(u, sink, start, ?u.vm[out_at::usize], out_len::u64);
        u.flushed = start + out_len::u64;
        if (u.nfilters > 0 && u.filters[0].start < u.flushed) { ret E.BAD_DATA; }
    }
    ret E.OK;
}

# ---------------------------------------------------------------- decoding

fun length_base(code: u32, extra: *u32) u32 {
    # 28 length slots: 8 with no extra bits, then 4 each with 1..5
    if (code < 8) {
        @extra = 0;
        ret code;
    }
    val group: u32 = (code - 8) / 4 + 1;
    @extra = group;
    ret (4 + ((code - 8) % 4)) << group;
}

fun slot_bits(slot: u32) u32 {
    if (slot < 4)  { ret 0; }
    if (slot < 36) { ret slot / 2 - 1; }
    if (slot < 48) { ret 16; }
    ret 18;
}

var dist_base:    [60]u64;
var dist_extra:   [60]u32;
var tables_ready: bool = false;

fun build_dist_tables() {
    if (tables_ready) { ret; }
    var base: u64 = 0;
    var i:    u32 = 0;
    for (i < 60) {
        dist_base[i::usize]  = base;
        dist_extra[i::usize] = slot_bits(i);
        base                 = base + (1::u64 << slot_bits(i)::u64);
        i                    = i + 1;
    }
    tables_ready = true;
}

fun push_dist(u: *Unpacker, d: u64) {
    u.old_dist[3] = u.old_dist[2];
    u.old_dist[2] = u.old_dist[1];
    u.old_dist[1] = u.old_dist[0];
    u.old_dist[0] = d;
}

# one LZ symbol; sets u.ended at the end of the file's data
fun lz_step(u: *Unpacker) E.Code {
    val s: u32 = decode(u, ?u.ld);
    if (s < 256) {
        put(u, s::u8);
        ret E.OK;
    }
    if (s >= 271 && s < NC::u32) {
        var lx:  u32 = 0;
        var len: u64 = length_base(s - 271, ?lx)::u64 + 3;
        if (lx > 0) { len = len + BI.bits(?u.bi, lx)::u64; }
        val slot: u32 = decode(u, ?u.dd);
        if (slot >= DC::u32) { ret E.BAD_DATA; }
        var dist: u64 = dist_base[slot::usize] + 1;
        val dx:   u32 = dist_extra[slot::usize];
        if (dx > 0) {
            if (slot > 9) {
                if (dx > 4) { dist = dist + (BI.bits(?u.bi, dx - 4)::u64 << 4); }
                if (u.low_rep > 0) {
                    u.low_rep = u.low_rep - 1;
                    dist      = dist + u.last_low;
                }
                or {
                    val low: u32 = decode(u, ?u.ldd);
                    if (low == 16) {
                        u.low_rep = 15;
                        dist      = dist + u.last_low;
                    }
                    or (low < 16) {
                        dist       = dist + low::u64;
                        u.last_low = low::u64;
                    }
                    or {
                        ret E.BAD_DATA;
                    }
                }
            }
            or {
                dist = dist + BI.bits(?u.bi, dx)::u64;
            }
        }
        if (dist >= 0x2000) {
            len = len + 1;
            if (dist >= 0x40000) { len = len + 1; }
        }
        push_dist(u, dist);
        u.last_dist = dist;
        u.last_len  = len;
        copy_match(u, len, dist);
        ret E.OK;
    }
    if (s == 256) {
        if (BI.bits(?u.bi, 1) != 0) {
            # new tables in the middle of the file
            if (!read_tables(u)) { ret E.BAD_DATA; }
            ret E.OK;
        }
        # end of file; the next bit says whether the next solid file
        # starts with new tables
        u.tables_read = BI.bits(?u.bi, 1) == 0;
        u.ended       = true;
        ret E.OK;
    }
    if (s == 257) { ret read_filter_lz(u); }
    if (s == 258) {
        if (u.last_len != 0) { copy_match(u, u.last_len, u.last_dist); }
        ret E.OK;
    }
    if (s < 263) {
        val idx:  usize = (s - 259)::usize;
        val dist: u64   = u.old_dist[idx];
        val lc:   u32   = decode(u, ?u.rd);
        if (lc >= RC::u32) { ret E.BAD_DATA; }
        var lx:  u32 = 0;
        var len: u64 = length_base(lc, ?lx)::u64 + 2;
        if (lx > 0) { len = len + BI.bits(?u.bi, lx)::u64; }
        var k: usize = idx;
        for (k > 0) {
            u.old_dist[k] = u.old_dist[k - 1];
            k             = k - 1;
        }
        u.old_dist[0] = dist;
        u.last_dist   = dist;
        u.last_len    = len;
        copy_match(u, len, dist);
        ret E.OK;
    }
    if (s < 271) {
        # short distances: bases 0,4,8,16,32,64,128,192 with 2,2,3,4,5,6,6,6 bits
        val i:     u32 = s - 263;
        var sbits: u32 = 6;
        var sbase: u64 = 0;
        if (i == 0) {
            sbits = 2;
            sbase = 0;
        }
        or (i == 1) {
            sbits = 2;
            sbase = 4;
        }
        or (i == 2) {
            sbits = 3;
            sbase = 8;
        }
        or (i == 3) {
            sbits = 4;
            sbase = 16;
        }
        or (i == 4) {
            sbits = 5;
            sbase = 32;
        }
        or (i == 5) {
            sbits = 6;
            sbase = 64;
        }
        or (i == 6) {
            sbits = 6;
            sbase = 128;
        }
        or {
            sbits = 6;
            sbase = 192;
        }
        val dist: u64 = sbase + 1 + BI.bits(?u.bi, sbits)::u64;
        push_dist(u, dist);
        u.last_dist = dist;
        u.last_len  = 2;
        copy_match(u, 2, dist);
        ret E.OK;
    }
    ret E.BAD_DATA;
}

# one PPMd symbol or escape command
fun ppm_step(u: *Unpacker) E.Code {
    val c: i32 = PM.decode_symbol(?u.model);
    if (c < 0) { ret E.BAD_DATA; }
    if (c::u32 != u.ppm_esc) {
        put(u, c::u8);
        ret E.OK;
    }
    val cmd: i32 = PM.decode_symbol(?u.model);
    if (cmd < 0) { ret E.BAD_DATA; }
    if (cmd == 0) {
        if (!read_tables(u)) { ret E.BAD_DATA; }
        ret E.OK;
    }
    if (cmd == 2) {
        # end of file; a following solid file starts with a table block
        u.tables_read = false;
        u.ended       = true;
        ret E.OK;
    }
    if (cmd == 3) { ret read_filter_ppm(u); }
    if (cmd == 4) {
        var ok:   bool = true;
        var dist: u64  = 0;
        var i:    u32  = 0;
        for (i < 3) {
            dist = (dist << 8) | ppm_byte(u, ?ok)::u64;
            i    = i + 1;
        }
        val len: u64 = ppm_byte(u, ?ok)::u64 + 32;
        if (!ok) { ret E.BAD_DATA; }
        copy_match(u, len, dist + 2);
        ret E.OK;
    }
    if (cmd == 5) {
        var ok:  bool = true;
        val len: u64  = ppm_byte(u, ?ok)::u64 + 4;
        if (!ok) { ret E.BAD_DATA; }
        copy_match(u, len, 1);
        ret E.OK;
    }
    # 1, and anything else: the escape byte itself
    put(u, c::u8);
    ret E.OK;
}

# decompress one file
# ---
# unp_size: bytes the file unpacks to
# known:    false when the size is unknown and the stream end decides
# solid:    continue the previous file's window, tables and model
pub fun run(u: *Unpacker, p: *S.Packed, sink: *S.Sink, unp_size: u64, known: bool, solid: bool) E.Code {
    build_dist_tables();
    if (u.window == nil) {
        u.window = M.alloc(WINDOW::usize);
        if (u.window == nil) { ret E.NO_MEMORY; }
    }
    if (solid) {
        if (u.broken) { ret E.SOLID_BROKEN; }
    }
    or {
        reset(u);
        u.broken = false;
    }
    if (!BI.init(?u.bi, p)) { ret E.NO_MEMORY; }
    u.file_start = u.pos;
    if (known) { u.file_end = u.pos + unp_size; }
    or         { u.file_end = 0xFFFFFFFFFFFFFFFF; }
    u.nfilters = 0;
    u.ended    = false;

    var rc: E.Code = E.OK;
    if (!u.tables_read && !read_tables(u)) { rc = E.BAD_DATA; }
    for (rc == E.OK && !u.ended) {
        val done: bool = known && u.pos >= u.file_end;
        if (done) {
            # the end-of-file marker may still follow, and the next solid
            # file depends on it: PPMd models it like any symbol, and the LZ
            # marker says whether new tables come next
            if (BI.exhausted(?u.bi)) { brk; }
            if (!u.ppm) {
                val peek: u32 = HF.lookup(?u.ld, BI.peek16(?u.bi)) & 0xFFFF;
                if (peek != 256) { brk; }
            }
        }
        if (u.pos - u.flushed >= WINDOW - MAX_MATCH - 0x10000) {
            rc = flush(u, sink);
            if (rc != E.OK) { brk; }
            if (u.pos - u.flushed >= WINDOW - MAX_MATCH - 0x10000) {
                rc = E.BAD_DATA;
                brk;
            }
        }
        if (BI.exhausted(?u.bi)) {
            if (!known) { brk; }
            rc = E.TRUNCATED;
            brk;
        }
        if (u.ppm) { rc = ppm_step(u); }
        or         { rc = lz_step(u); }
        if (done && (rc != E.OK || u.pos > u.file_end)) {
            # past the end of a complete file: trailing bytes, not damage
            rc = E.OK;
            brk;
        }
    }
    if (rc == E.OK)                                { rc = flush(u, sink); }
    if (rc == E.OK && known && u.pos < u.file_end) { rc = E.TRUNCATED; }
    if (rc != E.OK)                                { u.broken = true; }
    ret rc;
}
