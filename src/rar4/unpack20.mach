# RAR 2.0 decompression (unpack versions 20 and 26, written by RAR 2.x)
#
# an MSB-first bit stream. a table block starts with an audio bit and a
# "keep previous lengths" bit, then 19 four-bit lengths for the code length
# code, then the lengths (deltas mod 16 to the previous ones; 16 repeats the
# previous length 3-6 times, 17 and 18 write 3-10 or 11-138 zeros) for:
#
#   LZ:    298 main symbols, 48 distance slots, 28 repeat lengths
#   audio: 257 symbols for each of 1-4 channels (2 bits give the count)
#
# main symbols: 0-255 literal, 256 repeat the last match, 257-260 one of the
# last four distances, 261-268 a short distance with length 2, 269 new
# tables, 270-297 a new match. audio symbols: 0-255 a prediction residual,
# 256 new tables. tables and window carry over between solid files; a file
# ends when its size is reached.
#
# written from the format as The Unarchiver's XADMaster (LGPL-2.1) decodes
# it, read only, and checked against archives RAR 2.50 made; see
# docs/provenance-notes.md.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use E:  ramjet.errors;
use HF: ramjet.huffman;
use M:  ramjet.mem;
use BI: ramjet.rar4.bitin;
use S:  ramjet.stream;

val WINDOW:    u64   = 0x100000;
val MAX_MATCH: u64   = 0x200;
val NC:        usize = 298;
val DC:        usize = 48;
val RC:        usize = 28;
val AC:        usize = 257;

# the adaptive predictor of one audio channel
rec Audio {
    last_byte:  i32;
    last_delta: i32;
    d1:         i32;
    d2:         i32;
    d3:         i32;
    d4:         i32;
    w1:         i32;
    w2:         i32;
    w3:         i32;
    w4:         i32;
    w5:         i32;
    err:        [11]u32;
    count:      u32;
}

pub rec Unpacker {
    window:     *u8;
    pos:        u64;
    flushed:    u64;
    file_start: u64;
    file_end:   u64;

    lengths: [1028]u8;
    ld:      HF.Huff;
    dd:      HF.Huff;
    rd:      HF.Huff;
    ad:      [4]HF.Huff;

    audio:         bool;
    channels:      u32;
    channel:       u32;
    channel_delta: i32;
    astate:        [4]Audio;

    old_dist:    [4]u64;
    old_idx:     u32;
    last_dist:   u64;
    last_len:    u64;
    tables_read: bool;
    broken:      bool;
    # where the previous file of a solid stream ended
    stream_end: u64;

    bi: BI.BitIn;
}

pub fun init(u: *Unpacker) {
    u.window = nil;
    u.bi.buf = nil;
    u.broken = false;
    reset(u);
}

fun reset(u: *Unpacker) {
    u.pos        = 0;
    u.flushed    = 0;
    u.stream_end = 0;
    var i: usize = 0;
    for (i < 1028) {
        u.lengths[i] = 0;
        i            = i + 1;
    }
    u.audio         = false;
    u.channels      = 1;
    u.channel       = 0;
    u.channel_delta = 0;
    M.zero_bytes((?u.astate[0])::*u8, 4 * $size_of(Audio));
    u.old_dist[0] = 0;
    u.old_dist[1] = 0;
    u.old_dist[2] = 0;
    u.old_dist[3] = 0;
    u.old_idx     = 0;
    u.last_dist   = 0;
    u.last_len    = 0;
    u.tables_read = false;
}

pub fun dnit(u: *Unpacker) {
    if (u.window != nil) { M.free(u.window, WINDOW::usize); }
    u.window = nil;
    BI.dnit(?u.bi);
}

fun decode(u: *Unpacker, h: *HF.Huff) u32 {
    val r: u32 = HF.lookup(h, BI.peek16(?u.bi));
    BI.skip(?u.bi, r >> 16);
    ret r & 0xFFFF;
}

fun read_tables(u: *Unpacker) bool {
    u.audio = BI.bits(?u.bi, 1) != 0;
    if (BI.bits(?u.bi, 1) == 0) {
        var i: usize = 0;
        for (i < 1028) {
            u.lengths[i] = 0;
            i            = i + 1;
        }
    }
    var count: usize = NC + DC + RC;
    if (u.audio) {
        u.channels = BI.bits(?u.bi, 2) + 1;
        count      = u.channels::usize * AC;
        if (u.channel >= u.channels) { u.channel = 0; }
    }
    var pre: [19]u8;
    var i:   usize = 0;
    for (i < 19) {
        pre[i] = BI.bits(?u.bi, 4)::u8;
        i      = i + 1;
    }
    var bd: HF.Huff;
    if (!HF.build(?bd, ?pre[0], 19)) { ret false; }
    i = 0;
    for (i < count) {
        if (BI.exhausted(?u.bi)) { ret false; }
        val s: u32 = decode(u, ?bd);
        if (s < 16) {
            u.lengths[i] = ((u.lengths[i]::u32 + s) & 15)::u8;
            i            = i + 1;
        }
        or (s == 16) {
            if (i == 0) { ret false; }
            var n: u32 = BI.bits(?u.bi, 2) + 3;
            for (n > 0 && i < count) {
                u.lengths[i] = u.lengths[i - 1];
                i            = i + 1;
                n            = n - 1;
            }
        }
        or (s == 17 || s == 18) {
            var n: u32 = 0;
            if (s == 17) { n = BI.bits(?u.bi, 3) + 3; }
            or           { n = BI.bits(?u.bi, 7) + 11; }
            for (n > 0 && i < count) {
                u.lengths[i] = 0;
                i            = i + 1;
                n            = n - 1;
            }
        }
        or { ret false; }
    }
    if (u.audio) {
        var c: u32 = 0;
        for (c < u.channels) {
            if (!HF.build(?u.ad[c::usize], ?u.lengths[c::usize * AC], AC)) { ret false; }
            c = c + 1;
        }
    }
    or {
        if (!HF.build(?u.ld, ?u.lengths[0], NC))       { ret false; }
        if (!HF.build(?u.dd, ?u.lengths[NC], DC))      { ret false; }
        if (!HF.build(?u.rd, ?u.lengths[NC + DC], RC)) { ret false; }
    }
    u.tables_read = true;
    ret true;
}

# ---------------------------------------------------------------- output

fun put(u: *Unpacker, b: u8) {
    u.window[(u.pos & (WINDOW - 1))::usize] = b;
    u.pos                                   = u.pos + 1;
}

fun copy_match(u: *Unpacker, len: u64, dist: u64) {
    val mask: u64 = WINDOW - 1;
    var n:    u64 = 0;
    for (n < len) {
        u.window[((u.pos + n) & mask)::usize] = u.window[((u.pos + n - dist) & mask)::usize];
        n                                     = n + 1;
    }
    u.pos = u.pos + len;
}

fun flush(u: *Unpacker, sink: *S.Sink) {
    var a: u64 = u.flushed;
    var b: u64 = u.pos;
    if (b > u.file_end) { b = u.file_end; }
    for (a < b) {
        val off: u64 = a & (WINDOW - 1);
        var n:   u64 = b - a;
        if (n > WINDOW - off) { n = WINDOW - off; }
        S.sink_write(sink, ?u.window[off::usize], n::usize);
        a = a + n;
    }
    u.flushed = u.pos;
}

# ---------------------------------------------------------------- decoding

fun abs32(v: i32) u32 {
    if (v < 0) { ret (0 - v)::u32; }
    ret v::u32;
}

# one byte from a prediction residual; the five weights adapt every 32
# bytes toward whichever prediction erred least
fun audio_byte(u: *Unpacker, a: *Audio, residual: u32) u8 {
    a.count = a.count + 1;
    a.d4    = a.d3;
    a.d3    = a.d2;
    a.d2    = a.last_delta - a.d1;
    a.d1    = a.last_delta;
    val cd:   i32 = u.channel_delta;
    val pred: i32 = ((8 * a.last_byte + a.w1 * a.d1 + a.w2 * a.d2 + a.w3 * a.d3 + a.w4 * a.d4 + a.w5 * cd) >> 3) & 0xFF;
    val byte: i32 = (pred - residual::i32) & 0xFF;
    val pe:   i32 = residual::u8::i8::i32 * 8;
    a.err[0]        = a.err[0] + abs32(pe);
    a.err[1]        = a.err[1] + abs32(pe - a.d1);
    a.err[2]        = a.err[2] + abs32(pe + a.d1);
    a.err[3]        = a.err[3] + abs32(pe - a.d2);
    a.err[4]        = a.err[4] + abs32(pe + a.d2);
    a.err[5]        = a.err[5] + abs32(pe - a.d3);
    a.err[6]        = a.err[6] + abs32(pe + a.d3);
    a.err[7]        = a.err[7] + abs32(pe - a.d4);
    a.err[8]        = a.err[8] + abs32(pe + a.d4);
    a.err[9]        = a.err[9] + abs32(pe - cd);
    a.err[10]       = a.err[10] + abs32(pe + cd);
    a.last_delta    = (byte - a.last_byte)::u8::i8::i32;
    u.channel_delta = a.last_delta;
    a.last_byte     = byte;
    if ((a.count & 0x1F) == 0) {
        var best: usize = 0;
        var k:    usize = 1;
        for (k < 11) {
            if (a.err[k] < a.err[best]) { best = k; }
            k = k + 1;
        }
        k = 0;
        for (k < 11) {
            a.err[k] = 0;
            k        = k + 1;
        }
        if (best == 1 && a.w1 >= -16) { a.w1 = a.w1 - 1; }
        or (best == 2 && a.w1 < 16)   { a.w1 = a.w1 + 1; }
        or (best == 3 && a.w2 >= -16) { a.w2 = a.w2 - 1; }
        or (best == 4 && a.w2 < 16)   { a.w2 = a.w2 + 1; }
        or (best == 5 && a.w3 >= -16) { a.w3 = a.w3 - 1; }
        or (best == 6 && a.w3 < 16)   { a.w3 = a.w3 + 1; }
        or (best == 7 && a.w4 >= -16) { a.w4 = a.w4 - 1; }
        or (best == 8 && a.w4 < 16)   { a.w4 = a.w4 + 1; }
        or (best == 9 && a.w5 >= -16) { a.w5 = a.w5 - 1; }
        or (best == 10 && a.w5 < 16)  { a.w5 = a.w5 + 1; }
    }
    ret byte::u8;
}

# length and distance slots: 28 lengths (8 without extra bits, then 4 each
# with 1-5) and 48 distances (pairs with growing extra bits, 16 at most)
fun length_base(code: u32, extra: *u32) u32 {
    if (code < 8) {
        @extra = 0;
        ret code;
    }
    val group: u32 = (code - 8) / 4 + 1;
    @extra = group;
    ret (4 + ((code - 8) % 4)) << group;
}

fun dist_bits(slot: u32) u32 {
    if (slot < 4)  { ret 0; }
    if (slot < 36) { ret slot / 2 - 1; }
    ret 16;
}

var dist_base:  [48]u64;
var dist_ready: bool = false;

fun build_dist() {
    if (dist_ready) { ret; }
    var base: u64 = 0;
    var i:    u32 = 0;
    for (i < 48) {
        dist_base[i::usize] = base;
        base                = base + (1::u64 << dist_bits(i)::u64);
        i                   = i + 1;
    }
    dist_ready = true;
}

fun match(u: *Unpacker, dist: u64, len: u64) {
    u.last_dist                        = dist;
    u.old_dist[(u.old_idx & 3)::usize] = dist;
    u.old_idx                          = u.old_idx + 1;
    u.last_len                         = len;
    copy_match(u, len, dist);
}

fun lz_step(u: *Unpacker) E.Code {
    val s: u32 = decode(u, ?u.ld);
    if (s < 256) {
        put(u, s::u8);
        ret E.OK;
    }
    if (s == 256) {
        match(u, u.last_dist, u.last_len);
        ret E.OK;
    }
    if (s < 261) {
        val dist: u64 = u.old_dist[((u.old_idx - (s - 256)) & 3)::usize];
        val lc:   u32 = decode(u, ?u.rd);
        if (lc >= RC::u32) { ret E.BAD_DATA; }
        var lx:  u32 = 0;
        var len: u64 = length_base(lc, ?lx)::u64 + 2;
        if (lx > 0)          { len = len + BI.bits(?u.bi, lx)::u64; }
        if (dist >= 0x40000) { len = len + 1; }
        if (dist >= 0x2000)  { len = len + 1; }
        if (dist >= 0x101)   { len = len + 1; }
        match(u, dist, len);
        ret E.OK;
    }
    if (s < 269) {
        # short distances: bases 0,4,8,16,32,64,128,192 with 2,2,3,4,5,6,6,6 bits
        val i:    u32 = s - 261;
        var bits: u32 = 6;
        var base: u64 = 192;
        if (i == 0) {
            bits = 2;
            base = 0;
        }
        or (i == 1) {
            bits = 2;
            base = 4;
        }
        or (i == 2) {
            bits = 3;
            base = 8;
        }
        or (i == 3) {
            bits = 4;
            base = 16;
        }
        or (i == 4) {
            bits = 5;
            base = 32;
        }
        or (i == 5) {
            bits = 6;
            base = 64;
        }
        or (i == 6) {
            bits = 6;
            base = 128;
        }
        match(u, base + 1 + BI.bits(?u.bi, bits)::u64, 2);
        ret E.OK;
    }
    if (s == 269) {
        if (!read_tables(u)) { ret E.BAD_DATA; }
        ret E.OK;
    }
    if (s >= NC::u32) { ret E.BAD_DATA; }
    var lx:  u32 = 0;
    var len: u64 = length_base(s - 270, ?lx)::u64 + 3;
    if (lx > 0) { len = len + BI.bits(?u.bi, lx)::u64; }
    val slot: u32 = decode(u, ?u.dd);
    if (slot >= DC::u32) { ret E.BAD_DATA; }
    var dist: u64 = dist_base[slot::usize] + 1;
    val dx:   u32 = dist_bits(slot);
    if (dx > 0)          { dist = dist + BI.bits(?u.bi, dx)::u64; }
    if (dist >= 0x40000) { len = len + 1; }
    if (dist >= 0x2000)  { len = len + 1; }
    match(u, dist, len);
    ret E.OK;
}

fun audio_step(u: *Unpacker) E.Code {
    val s: u32 = decode(u, ?u.ad[u.channel::usize]);
    if (s == 256) {
        if (!read_tables(u)) { ret E.BAD_DATA; }
        ret E.OK;
    }
    if (s > 256) { ret E.BAD_DATA; }
    put(u, audio_byte(u, ?u.astate[u.channel::usize], s));
    u.channel = u.channel + 1;
    if (u.channel == u.channels) { u.channel = 0; }
    ret E.OK;
}

# decompress one file
# ---
# unp_size: bytes the file unpacks to
# known:    false when the size is unknown and the input end decides
# solid:    continue the previous file's window, tables and state
pub fun run(u: *Unpacker, p: *S.Packed, sink: *S.Sink, unp_size: u64, known: bool, solid: bool) E.Code {
    build_dist();
    if (u.window == nil) {
        u.window = M.alloc(WINDOW::usize);
        if (u.window == nil) { ret E.NO_MEMORY; }
    }
    if (solid) {
        if (u.broken) { ret E.SOLID_BROKEN; }
    }
    or {
        reset(u);
        u.broken = false;
    }
    if (!BI.init(?u.bi, p)) { ret E.NO_MEMORY; }
    # a match of the previous file may already have produced this file's
    # first bytes, so the file starts where the previous one ended
    u.file_start = u.stream_end;
    u.flushed    = u.file_start;
    if (known) { u.file_end = u.file_start + unp_size; }
    or         { u.file_end = 0xFFFFFFFFFFFFFFFF; }

    var rc: E.Code = E.OK;
    if (!u.tables_read && !read_tables(u)) { rc = E.BAD_DATA; }
    for (rc == E.OK && u.pos < u.file_end) {
        if (u.pos - u.flushed >= WINDOW - MAX_MATCH - 0x1000) { flush(u, sink); }
        if (BI.exhausted(?u.bi)) {
            if (known) { rc = E.TRUNCATED; }
            brk;
        }
        if (u.audio) { rc = audio_step(u); }
        or           { rc = lz_step(u); }
    }
    if (rc == E.OK)                                { flush(u, sink); }
    if (rc == E.OK && known && u.pos < u.file_end) { rc = E.TRUNCATED; }
    if (known)                                     { u.stream_end = u.file_end; }
    or                                             { u.stream_end = u.pos; }
    if (rc != E.OK)                                { u.broken = true; }
    ret rc;
}
