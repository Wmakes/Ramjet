# RAR 5.0 decompression (compression algorithm version 0)
#
# the packed data of a file is a sequence of blocks:
#
#   flags (1 byte)   bit 7 tables present, bit 6 last block, bits 3-5 number
#                    of size bytes minus 1, bits 0-2 valid bits in the last
#                    byte minus 1
#   check (1 byte)   0x5A ^ flags ^ every size byte
#   size  (1-3 bytes, little endian): bytes of block data that follow
#
# block data is read MSB-first as a bit stream. a block that carries tables
# starts with 20 four-bit code lengths (15 is an escape: a following 0 means
# the value 15, anything else n means n+2 zero lengths) for the table that
# then codes the 430 lengths of the main tables:
#
#   306 literal/length symbols, 64 distance slots, 16 low distance bits,
#   44 repeat lengths
#
# with symbols 16/17 repeating the previous length (3 bits + 3, 7 bits + 11)
# and 18/19 emitting zeros (3 bits + 3, 7 bits + 11). each table is a
# canonical prefix code over its lengths.
#
# main symbols: 0-255 literal bytes, 256 a filter, 257 repeat the last match,
# 258-261 a match at one of the last four distances, 262+ a new match. the
# output goes into a circular window; it is handed to the sink in flush(),
# which runs pending filters over their ranges once those are complete.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use B:  ramjet.bytes;
use E:  ramjet.errors;
use HF: ramjet.huffman;
use M:  ramjet.mem;
use S:  ramjet.stream;

val NC:     usize = 306;
val DC:     usize = 64;
val LDC:    usize = 16;
val RC:     usize = 44;
val BC:     usize = 20;
val TABLES: usize = 430;

# the longest match: length code 43 with 9 extra bits, plus 3 for distance
val     MAX_MATCH:   u64   = 0x1104;
val     MIN_WINDOW:  u64   = 0x800000;
val     MAX_FILTER:  u64   = 0x400000;
val     MAX_FILTERS: usize = 8192;
pub val MAX_DICT:    u64   = 0x100000000;

val FILTER_DELTA: u8 = 0;
val FILTER_E8:    u8 = 1;
val FILTER_E8E9:  u8 = 2;
val FILTER_ARM:   u8 = 3;

# a pending filter over [start, start + len) of the output stream
rec Filter {
    start:    u64;
    len:      u64;
    kind:     u8;
    channels: u8;
}

pub rec Unpacker {
    window: *u8;
    wsize:  u64;
    wmask:  u64;

    # absolute output positions: decoded so far, handed to the sink so far,
    # and where the current file started
    pos:        u64;
    flushed:    u64;
    file_start: u64;
    file_end:   u64;

    ld:          HF.Huff;
    dd:          HF.Huff;
    ldd:         HF.Huff;
    rd:          HF.Huff;
    bd:          HF.Huff;
    have_tables: bool;

    dist_cache: [4]u64;
    last_len:   u64;

    filters:    *Filter;
    nfilters:   usize;
    filter_buf: *u8;
    filter_cap: usize;

    # current block
    blk:        *u8;
    blk_cap:    usize;
    blk_len:    usize;
    bitpos:     u64;
    end_bits:   u64;
    last_block: bool;

    # set when a solid stream can no longer be continued
    broken: bool;
}

pub fun init(u: *Unpacker) {
    u.window      = nil;
    u.wsize       = 0;
    u.wmask       = 0;
    u.pos         = 0;
    u.flushed     = 0;
    u.file_start  = 0;
    u.file_end    = 0;
    u.have_tables = false;
    u.filters     = nil;
    u.nfilters    = 0;
    u.filter_buf  = nil;
    u.filter_cap  = 0;
    u.blk         = nil;
    u.blk_cap     = 0;
    u.blk_len     = 0;
    u.broken      = false;
    reset_state(u);
}

fun reset_state(u: *Unpacker) {
    u.dist_cache[0] = 0;
    u.dist_cache[1] = 0;
    u.dist_cache[2] = 0;
    u.dist_cache[3] = 0;
    u.last_len      = 0;
    u.have_tables   = false;
}

pub fun dnit(u: *Unpacker) {
    if (u.window != nil)     { M.free(u.window, u.wsize::usize); }
    if (u.filters != nil)    { M.free(u.filters::*u8, MAX_FILTERS * $size_of(Filter)); }
    if (u.filter_buf != nil) { M.free(u.filter_buf, u.filter_cap); }
    if (u.blk != nil)        { M.free(u.blk, u.blk_cap); }
    init(u);
}

# prepare for the next file
# ---
# dict:  dictionary size the file needs
# solid: continue the previous file's window and tables
pub fun begin(u: *Unpacker, dict: u64, solid: bool) E.Code {
    if (dict > MAX_DICT) { ret E.DICT_TOO_LARGE; }
    var want: u64 = MIN_WINDOW;
    for (want < dict) { want = want << 1; }

    if (solid && (u.broken || u.window == nil || want > u.wsize)) {
        # a solid file cannot start without the window the previous file left
        if (u.broken || u.window == nil) { ret E.SOLID_BROKEN; }
        ret E.DICT_TOO_LARGE;
    }
    if (!solid) {
        if (u.window == nil || want > u.wsize) {
            if (u.window != nil) { M.free(u.window, u.wsize::usize); }
            u.window = M.alloc(want::usize);
            if (u.window == nil) {
                u.wsize = 0;
                ret E.NO_MEMORY;
            }
            u.wsize = want;
            u.wmask = want - 1;
        }
        u.pos     = 0;
        u.flushed = 0;
        reset_state(u);
        u.broken = false;
    }
    if (u.filters == nil) {
        u.filters = M.alloc(MAX_FILTERS * $size_of(Filter))::*Filter;
        if (u.filters == nil) { ret E.NO_MEMORY; }
    }
    u.nfilters   = 0;
    u.file_start = u.pos;
    ret E.OK;
}

# ---------------------------------------------------------------- bit input

# the next 32 bits of the block at the read position, MSB first; the block
# buffer carries 8 zero bytes past its end so this never reads outside it
#[inline]
fun peek32(u: *Unpacker) u32 {
    val byte: usize = (u.bitpos >> 3)::usize;
    val p:    *u8   = ?u.blk[byte];
    val v:    u64   = (p[0]::u64 << 32) | (p[1]::u64 << 24) | (p[2]::u64 << 16) | (p[3]::u64 << 8) | p[4]::u64;
    ret ((v << (u.bitpos & 7)) >> 8)::u32;
}

#[inline]
fun peek16(u: *Unpacker) u32 {
    ret peek32(u) >> 16;
}

#[inline]
fun skip_bits(u: *Unpacker, n: u32) {
    u.bitpos = u.bitpos + n::u64;
}

#[inline]
fun get_bits(u: *Unpacker, n: u32) u32 {
    if (n == 0) { ret 0; }
    val v: u32 = peek32(u) >> (32 - n);
    skip_bits(u, n);
    ret v;
}

fun past_end(u: *Unpacker) bool {
    ret u.bitpos > u.end_bits;
}

# ---------------------------------------------------------------- huffman

fun build(h: *HF.Huff, lengths: *u8, n: usize) bool {
    ret HF.build(h, lengths, n);
}

# decode one symbol; returns 0xFFFF for a code that matches nothing
#[inline]
fun decode(u: *Unpacker, h: *HF.Huff) u32 {
    val r: u32 = HF.lookup(h, peek16(u));
    skip_bits(u, r >> 16);
    ret r & 0xFFFF;
}

fun read_tables(u: *Unpacker) bool {
    var bl: [20]u8;
    var i:  usize = 0;
    for (i < BC) {
        val v: u8 = get_bits(u, 4)::u8;
        if (v == 15) {
            val z: u8 = get_bits(u, 4)::u8;
            if (z == 0) {
                bl[i] = 15;
                i     = i + 1;
            }
            or {
                var k: usize = 0;
                for (k < z::usize + 2 && i < BC) {
                    bl[i] = 0;
                    i     = i + 1;
                    k     = k + 1;
                }
            }
        }
        or {
            bl[i] = v;
            i     = i + 1;
        }
    }
    if (!build(?u.bd, ?bl[0], BC)) { ret false; }

    var lens: [430]u8;
    i = 0;
    for (i < TABLES) {
        if (past_end(u)) { ret false; }
        val sym: u32 = decode(u, ?u.bd);
        if (sym < 16) {
            lens[i] = sym::u8;
            i       = i + 1;
        }
        or (sym == 16 || sym == 17) {
            if (i == 0) { ret false; }
            var n: u32 = 0;
            if (sym == 16) { n = get_bits(u, 3) + 3; }
            or             { n = get_bits(u, 7) + 11; }
            val prev: u8 = lens[i - 1];
            for (n > 0 && i < TABLES) {
                lens[i] = prev;
                i       = i + 1;
                n       = n - 1;
            }
        }
        or (sym == 18 || sym == 19) {
            var n: u32 = 0;
            if (sym == 18) { n = get_bits(u, 3) + 3; }
            or             { n = get_bits(u, 7) + 11; }
            for (n > 0 && i < TABLES) {
                lens[i] = 0;
                i       = i + 1;
                n       = n - 1;
            }
        }
        or {
            ret false;
        }
    }
    if (!build(?u.ld, ?lens[0], NC))             { ret false; }
    if (!build(?u.dd, ?lens[NC], DC))            { ret false; }
    if (!build(?u.ldd, ?lens[NC + DC], LDC))     { ret false; }
    if (!build(?u.rd, ?lens[NC + DC + LDC], RC)) { ret false; }
    u.have_tables = true;
    ret true;
}

# ---------------------------------------------------------------- blocks

# read the next block header and data into the block buffer
fun read_block(u: *Unpacker, p: *S.Packed) E.Code {
    var hdr: [5]u8;
    if (S.packed_read(p, ?hdr[0], 2) != 2) { ret E.TRUNCATED; }
    val flags: u8    = hdr[0];
    val nsize: usize = ((flags >> 3) & 7)::usize + 1;
    if (nsize > 3)                                 { ret E.BAD_DATA; }
    if (S.packed_read(p, ?hdr[2], nsize) != nsize) { ret E.TRUNCATED; }
    var size:  usize = 0;
    var check: u8    = 0x5A ^ flags;
    var i:     usize = 0;
    for (i < nsize) {
        size  = size | (hdr[2 + i]::usize << (8 * i));
        check = check ^ hdr[2 + i];
        i     = i + 1;
    }
    if (check != hdr[1]) { ret E.BAD_DATA; }

    if (size + 8 > u.blk_cap) {
        if (u.blk != nil) { M.free(u.blk, u.blk_cap); }
        var cap: usize = 0x10000;
        for (cap < size + 8) { cap = cap << 1; }
        u.blk = M.alloc(cap);
        if (u.blk == nil) {
            u.blk_cap = 0;
            ret E.NO_MEMORY;
        }
        u.blk_cap = cap;
    }
    if (S.packed_read(p, u.blk, size) != size) { ret E.TRUNCATED; }
    i = 0;
    for (i < 8) {
        u.blk[size + i] = 0;
        i               = i + 1;
    }
    u.blk_len = size;
    u.bitpos  = 0;
    val bits_in_last: u64 = (flags & 7)::u64 + 1;
    if (size == 0) {
        u.end_bits = 0;
    }
    or {
        u.end_bits = (size::u64 - 1) * 8 + bits_in_last;
    }
    u.last_block = (flags & 0x40) != 0;
    if ((flags & 0x80) != 0) {
        if (!read_tables(u)) { ret E.BAD_DATA; }
    }
    if (!u.have_tables) { ret E.BAD_DATA; }
    ret E.OK;
}

# ---------------------------------------------------------------- output

#[inline]
fun put(u: *Unpacker, b: u8) {
    u.window[(u.pos & u.wmask)::usize] = b;
    u.pos                              = u.pos + 1;
}

#[inline]
fun copy_match(u: *Unpacker, len: u64, dist: u64) {
    var src:  u64 = u.pos - dist;
    val d:    u64 = u.pos & u.wmask;
    val sidx: u64 = src & u.wmask;
    # the common case: no wrap, 8 bytes or more apart, slack after the end
    if (dist >= 8 && dist <= u.pos && d + len + 8 <= u.wsize && sidx + len + 8 <= u.wsize) {
        M.lz_copy8(?u.window[d::usize], ?u.window[sidx::usize], len::usize);
        u.pos = u.pos + len;
        ret;
    }
    var n:    u64 = 0;
    val w:    *u8 = u.window;
    val mask: u64 = u.wmask;
    for (n < len) {
        w[((u.pos + n) & mask)::usize] = w[((src + n) & mask)::usize];
        n                              = n + 1;
    }
    u.pos = u.pos + len;
}

# hand window bytes [from, to) to the sink, clipped to the current file
fun emit(u: *Unpacker, sink: *S.Sink, from: u64, to: u64) {
    var a: u64 = from;
    var b: u64 = to;
    if (b > u.file_end) { b = u.file_end; }
    for (a < b) {
        val off: u64 = a & u.wmask;
        var n:   u64 = b - a;
        if (n > u.wsize - off) { n = u.wsize - off; }
        S.sink_write(sink, ?u.window[off::usize], n::usize);
        a = a + n;
    }
}

fun ensure_filter_buf(u: *Unpacker, n: usize) bool {
    if (n <= u.filter_cap)   { ret true; }
    if (u.filter_buf != nil) { M.free(u.filter_buf, u.filter_cap); }
    var cap: usize = 0x10000;
    for (cap < n) { cap = cap << 1; }
    u.filter_buf = M.alloc(cap);
    if (u.filter_buf == nil) {
        u.filter_cap = 0;
        ret false;
    }
    u.filter_cap = cap;
    ret true;
}

# run one filter over its range of the window and send the result
fun run_filter(u: *Unpacker, f: *Filter, sink: *S.Sink) E.Code {
    val n: usize = f.len::usize;
    if (!ensure_filter_buf(u, n)) { ret E.NO_MEMORY; }
    val out: *u8 = u.filter_buf;
    # position of the range within the current file, which x86 and ARM
    # address conversion is relative to
    val file_pos: u64 = f.start - u.file_start;

    if (f.kind == FILTER_DELTA) {
        # the stored bytes are the per-channel differences, channel by channel
        val ch:  usize = f.channels::usize;
        var src: u64   = f.start;
        var c:   usize = 0;
        for (c < ch) {
            var prev: u8    = 0;
            var d:    usize = c;
            for (d < n) {
                prev   = prev - u.window[(src & u.wmask)::usize];
                out[d] = prev;
                src    = src + 1;
                d      = d + ch;
            }
            c = c + 1;
        }
    }
    or {
        var i: usize = 0;
        for (i < n) {
            out[i] = u.window[((f.start + i::u64) & u.wmask)::usize];
            i      = i + 1;
        }
        if (f.kind == FILTER_E8 || f.kind == FILTER_E8E9) {
            # relative call/jump targets were made absolute modulo 16 MB
            val fsize: u32 = 0x1000000;
            i = 0;
            for (i + 4 < n) {
                val op: u8 = out[i];
                i = i + 1;
                if (op == 0xE8 || (f.kind == FILTER_E8E9 && op == 0xE9)) {
                    val at:   u32 = ((file_pos + i::u64) % fsize::u64)::u32;
                    val addr: u32 = B.load_u32(?out[i]);
                    if ((addr & 0x80000000) != 0) {
                        if (((addr + at) & 0x80000000) == 0) { B.store_u32(?out[i], addr + fsize); }
                    }
                    or {
                        if (((addr - fsize) & 0x80000000) != 0) { B.store_u32(?out[i], addr - at); }
                    }
                    i = i + 4;
                }
            }
        }
        or (f.kind == FILTER_ARM) {
            # BL instructions carry word offsets made absolute
            i = 0;
            for (i + 3 < n) {
                if (out[i + 3] == 0xEB) {
                    var off: u32 = B.load_u32(?out[i]) & 0x00FFFFFF;
                    off = off - ((file_pos + i::u64) / 4)::u32;
                    B.store_u32(?out[i], (off & 0x00FFFFFF) | 0xEB000000);
                }
                i = i + 4;
            }
        }
        or {
            ret E.BAD_DATA;
        }
    }

    # the filtered range may run past the end of the file
    var keep: u64 = f.len;
    if (f.start + keep > u.file_end) {
        if (f.start >= u.file_end) { keep = 0; }
        or                         { keep = u.file_end - f.start; }
    }
    S.sink_write(sink, out, keep::usize);
    ret E.OK;
}

fun pop_filter(u: *Unpacker) {
    var i: usize = 1;
    for (i < u.nfilters) {
        u.filters[i - 1] = u.filters[i];
        i                = i + 1;
    }
    u.nfilters = u.nfilters - 1;
}

# send everything that is final: data before the next filter, and every
# filter whose range has been fully decoded
fun flush(u: *Unpacker, sink: *S.Sink) E.Code {
    for {
        if (u.nfilters == 0) {
            emit(u, sink, u.flushed, u.pos);
            u.flushed = u.pos;
            ret E.OK;
        }
        val f: *Filter = ?u.filters[0];
        if (u.flushed < f.start) {
            var upto: u64 = f.start;
            if (upto > u.pos) { upto = u.pos; }
            emit(u, sink, u.flushed, upto);
            u.flushed = upto;
            if (u.flushed < f.start) { ret E.OK; }
        }
        if (u.flushed > f.start)     { ret E.BAD_DATA; }
        if (u.pos < f.start + f.len) { ret E.OK; }
        val rc: E.Code = run_filter(u, f, sink);
        if (rc != E.OK) { ret rc; }
        u.flushed = f.start + f.len;
        pop_filter(u);
    }
    ret E.OK;
}

# ---------------------------------------------------------------- decoding

fun length_from_code(u: *Unpacker, code: u32) u64 {
    if (code < 8) { ret 2 + code::u64; }
    val lbits: u32 = code / 4 - 1;
    ret 2 + ((4 | (code & 3))::u64 << lbits::u64) + get_bits(u, lbits)::u64;
}

# a filter number: 2 bits giving 1-4 bytes, then the bytes little endian
fun filter_number(u: *Unpacker) u64 {
    val nbytes: u32 = get_bits(u, 2) + 1;
    var v:      u64 = 0;
    var i:      u32 = 0;
    for (i < nbytes) {
        v = v | (get_bits(u, 8)::u64 << (8 * i)::u64);
        i = i + 1;
    }
    ret v;
}

fun read_filter(u: *Unpacker) E.Code {
    val start:    u64 = filter_number(u);
    val len:      u64 = filter_number(u);
    val kind:     u8  = get_bits(u, 3)::u8;
    var channels: u8  = 0;
    if (kind == FILTER_DELTA)        { channels = get_bits(u, 5)::u8 + 1; }
    if (kind > FILTER_ARM)           { ret E.BAD_DATA; }
    if (len < 4 || len > MAX_FILTER) { ret E.BAD_DATA; }
    if (u.nfilters == MAX_FILTERS)   { ret E.BAD_DATA; }
    val abs: u64 = u.pos + start;
    # filters must come in order and must not overlap
    if (u.nfilters > 0) {
        val last: *Filter = ?u.filters[u.nfilters - 1];
        if (abs < last.start + last.len) { ret E.BAD_DATA; }
    }
    u.filters[u.nfilters] = Filter{start: abs, len: len, kind: kind, channels: channels};
    u.nfilters            = u.nfilters + 1;
    ret E.OK;
}

# decode the current block to its end, flushing as the window fills
fun decode_block(u: *Unpacker, sink: *S.Sink) E.Code {
    val room: u64 = u.wsize - MAX_MATCH;
    for (u.bitpos < u.end_bits) {
        if (u.pos - u.flushed >= room - MAX_MATCH) {
            val fc: E.Code = flush(u, sink);
            if (fc != E.OK)                            { ret fc; }
            if (u.pos - u.flushed >= room - MAX_MATCH) { ret E.BAD_DATA; }
        }

        val sym: u32 = decode(u, ?u.ld);
        if (sym < 256) {
            put(u, sym::u8);
            cnt;
        }
        if (sym >= 262 && sym < 0xFFFF) {
            var len:  u64 = length_from_code(u, sym - 262);
            val slot: u32 = decode(u, ?u.dd);
            if (slot >= DC::u32) { ret E.BAD_DATA; }
            var dist: u64 = 1;
            if (slot < 4) {
                dist = dist + slot::u64;
            }
            or {
                val dbits: u32 = slot / 2 - 1;
                dist = dist + ((2 | (slot & 1))::u64 << dbits::u64);
                if (dbits >= 4) {
                    if (dbits > 4) { dist = dist + (get_bits(u, dbits - 4)::u64 << 4); }
                    val low: u32 = decode(u, ?u.ldd);
                    if (low >= LDC::u32) { ret E.BAD_DATA; }
                    dist = dist + low::u64;
                }
                or {
                    dist = dist + get_bits(u, dbits)::u64;
                }
            }
            if (dist > 0x100) {
                len = len + 1;
                if (dist > 0x2000) {
                    len = len + 1;
                    if (dist > 0x40000) { len = len + 1; }
                }
            }
            if (dist > u.wsize) { ret E.BAD_DATA; }
            u.dist_cache[3] = u.dist_cache[2];
            u.dist_cache[2] = u.dist_cache[1];
            u.dist_cache[1] = u.dist_cache[0];
            u.dist_cache[0] = dist;
            u.last_len      = len;
            copy_match(u, len, dist);
            cnt;
        }
        if (sym == 256) {
            val rc: E.Code = read_filter(u);
            if (rc != E.OK) { ret rc; }
            cnt;
        }
        if (sym == 257) {
            if (u.last_len != 0) { copy_match(u, u.last_len, u.dist_cache[0]); }
            cnt;
        }
        if (sym >= 258 && sym < 262) {
            val idx:  usize = (sym - 258)::usize;
            val dist: u64   = u.dist_cache[idx];
            var k:    usize = idx;
            for (k > 0) {
                u.dist_cache[k] = u.dist_cache[k - 1];
                k               = k - 1;
            }
            u.dist_cache[0] = dist;
            val lc: u32 = decode(u, ?u.rd);
            if (lc >= RC::u32) { ret E.BAD_DATA; }
            val len: u64 = length_from_code(u, lc);
            u.last_len = len;
            copy_match(u, len, dist);
            cnt;
        }
        ret E.BAD_DATA;
    }
    if (u.bitpos > u.end_bits) { ret E.BAD_DATA; }
    ret E.OK;
}

# decompress one file's packed data into the sink
# ---
# unp_size: bytes the file unpacks to
# known:    false when the size is unknown and the stream end decides
pub fun run(u: *Unpacker, p: *S.Packed, sink: *S.Sink, unp_size: u64, known: bool) E.Code {
    if (known) {
        u.file_end = u.file_start + unp_size;
    }
    or {
        u.file_end = 0xFFFFFFFFFFFFFFFF;
    }
    var rc: E.Code = E.OK;
    for {
        rc = read_block(u, p);
        if (rc != E.OK) { brk; }
        rc = decode_block(u, sink);
        if (rc != E.OK) { brk; }
        if (known && u.pos - u.file_start > unp_size) {
            rc = E.BAD_DATA;
            brk;
        }
        if (u.last_block) { brk; }
    }
    if (rc == E.OK)                                              { rc = flush(u, sink); }
    if (rc == E.OK && u.nfilters > 0)                            { rc = E.BAD_DATA; }
    if (rc == E.OK && known && u.pos - u.file_start != unp_size) { rc = E.BAD_DATA; }
    if (rc != E.OK)                                              { u.broken = true; }
    ret rc;
}
