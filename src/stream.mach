# byte streams between the archive and the unpacker
#
# Packed reads an entry's data area across all of its volume parts, checking
# the CRC32 stored for every part but the last (that one covers the unpacked
# data), and decrypting with AES-256-CBC when the entry is encrypted.
#
# Sink receives unpacked bytes, hashes them with CRC32 and, when the entry
# has one, BLAKE2sp, and writes them to a file, to stdout or nowhere.

use ramjet.crypto.crc32;
use std.print;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use AR: ramjet.archive;
use ramjet.crypto.aes;
use b2:  ramjet.crypto.blake2;
use E:   ramjet.errors;
use M:   ramjet.mem;
use OC:  ramjet.rar4.crypt_old;
use sem: std.sync.semaphore;
use std.sync.thread;

pub rec Packed {
    ar:       *AR.Archive;
    seg:      i64;
    seg_off:  u64;
    left:     u64;
    part_crc: u32;
    part_b2:  b2.Blake2sp;
    part_bad: bool;

    encrypted: bool;
    # RAR 1.5 / 2.0 ciphers instead of AES (old = 15 or 20)
    old:       u32;
    c15:       OC.Rar15;
    c20:       OC.Rar20;
    key:       aes.Key;
    iv:        [16]u8;
    block:     [16]u8;
    block_pos: usize;
    block_len: usize;
}

pub fun packed_open(p: *Packed, ar: *AR.Archive, e: *AR.Entry) {
    p.ar       = ar;
    p.seg      = e.seg_first::i64;
    p.seg_off  = 0;
    p.left     = AR.segment(ar, e.seg_first).size;
    p.part_crc = crc32.init();
    b2.sp_init(?p.part_b2);
    p.part_bad  = false;
    p.encrypted = false;
    p.old       = 0;
    p.block_pos = 0;
    p.block_len = 0;
}

pub fun packed_encrypt(p: *Packed, key: *u8, iv: *u8) {
    p.encrypted = true;
    aes.init(?p.key, key);
    M.copy(?p.iv[0], iv, 16);
}

# data of RAR 1.5 (version 15) or RAR 2.0 (version 20) archives
pub fun packed_encrypt_old(p: *Packed, version: u32, pw: *u8, n: usize) {
    p.encrypted = true;
    p.old       = version;
    if (version == 15) { OC.rar15_init(?p.c15, pw, n); }
    or                 { OC.rar20_init(?p.c20, pw, n); }
}

# AES-128 data of RAR 2.9-4.x archives
pub fun packed_encrypt128(p: *Packed, key: *u8, iv: *u8) {
    p.encrypted = true;
    aes.init128(?p.key, key);
    M.copy(?p.iv[0], iv, 16);
}

# raw bytes from the current segments, advancing across volumes
fun raw_read(p: *Packed, dst: *u8, n: usize) usize {
    var done: usize = 0;
    for (done < n) {
        if (p.seg < 0) { ret done; }
        val s: *AR.Segment = AR.segment(p.ar, p.seg::usize);
        if (p.left == 0) {
            # finished this part: verify its packed CRC unless it is the last
            if (s.next >= 0 && s.has_crc && crc32.final(p.part_crc) != s.crc) { p.part_bad = true; }
            if (s.next >= 0 && s.has_blake2) {
                var d: [32]u8;
                b2.sp_final(?p.part_b2, ?d[0]);
                var k: usize = 0;
                for (k < 32) {
                    if (d[k] != s.blake2[k]) { p.part_bad = true; }
                    k = k + 1;
                }
            }
            p.seg      = s.next;
            p.seg_off  = 0;
            p.part_crc = crc32.init();
            b2.sp_init(?p.part_b2);
            if (p.seg >= 0) { p.left = AR.segment(p.ar, p.seg::usize).size; }
            cnt;
        }
        val v:  *AR.Volume = AR.volume(p.ar, s.vol);
        val at: u64        = s.offset + p.seg_off;
        if (at >= v.size::u64) {
            # data area runs past the end of a truncated volume
            p.seg = -1;
            ret done;
        }
        var take: u64 = (n - done)::u64;
        if (take > p.left)           { take = p.left; }
        if (at + take > v.size::u64) { take = v.size::u64 - at; }
        M.copy(?dst[done], ?v.data[at::usize], take::usize);
        p.part_crc = crc32.update(p.part_crc, ?dst[done], take::usize);
        # only parts before the last carry a hash of their packed bytes
        if (s.next >= 0 && s.has_blake2) { b2.sp_update(?p.part_b2, ?dst[done], take::usize); }
        p.seg_off = p.seg_off + take;
        p.left    = p.left - take;
        done      = done + take::usize;
    }
    ret done;
}

# read up to n bytes of (decrypted) packed data; fewer means the data ended
pub fun packed_read(p: *Packed, dst: *u8, n: usize) usize {
    if (!p.encrypted) { ret raw_read(p, dst, n); }
    if (p.old == 15) {
        val got: usize = raw_read(p, dst, n);
        var i:   usize = 0;
        for (i < got) {
            dst[i] = OC.rar15_byte(?p.c15, dst[i]);
            i      = i + 1;
        }
        ret got;
    }
    var done: usize = 0;
    for (done < n) {
        if (p.block_pos == p.block_len) {
            val got: usize = raw_read(p, ?p.block[0], 16);
            if (got != 16)   { ret done; }
            if (p.old == 20) { OC.rar20_block(?p.c20, ?p.block[0]); }
            or               { aes.cbc_decrypt(?p.key, ?p.iv[0], ?p.block[0], 16); }
            p.block_pos = 0;
            p.block_len = 16;
        }
        dst[done]   = p.block[p.block_pos];
        p.block_pos = p.block_pos + 1;
        done        = done + 1;
    }
    ret done;
}

# read every remaining byte so the per-part CRCs get checked
pub fun packed_drain(p: *Packed) {
    var tmp: [4096]u8;
    for (raw_read(p, ?tmp[0], 4096) == 4096) {}
}

pub val SINK_DISCARD: u8 = 0;
pub val SINK_FD:      u8 = 1;
pub val SINK_MEMORY:  u8 = 2;

pub rec Sink {
    mode:       u8;
    fd:         usize;
    crc:        u32;
    use_blake2: bool;
    blake2:     b2.Blake2sp;
    written:    u64;
    failed:     bool;
    mem:        *u8;
    mem_cap:    usize;

    # progress shown on the terminal while a large file is written
    prog_on:    bool;
    prog_total: u64;
    prog_next:  u64;
    prog_shown: bool;
    prog_verb:  str;
    prog_name:  *u8;

    # data goes through the worker thread in chunks (see sink_pipeline);
    # cur is the chunk being filled, or -1
    piped:   bool;
    cur:     i64;
    cur_len: usize;
}

pub fun sink_init(s: *Sink, mode: u8, fd: usize, blake2: bool) {
    s.mode       = mode;
    s.fd         = fd;
    s.crc        = crc32.init();
    s.use_blake2 = blake2;
    if (blake2) { b2.sp_init(?s.blake2); }
    s.written    = 0;
    s.failed     = false;
    s.mem        = nil;
    s.mem_cap    = 0;
    s.prog_on    = false;
    s.prog_shown = false;
    s.piped      = false;
    s.cur        = -1;
    s.cur_len    = 0;
}

# show "<verb> <name>  NN%" on stdout as data arrives, for files of `total`
# bytes; only worth it for files big enough to take a moment
pub fun sink_progress(s: *Sink, verb: str, name: *u8, total: u64) {
    if (total < 0x400000) { ret; }
    s.prog_on    = true;
    s.prog_total = total;
    s.prog_next  = 0;
    s.prog_verb  = verb;
    s.prog_name  = name;
}

fun progress(s: *Sink) {
    val pct: u64 = s.written * 100 / s.prog_total;
    if (pct > 99) { ret; }
    print.printf("\r{:<11} {}  {:3}%", s.prog_verb, s.prog_name::str, pct);
    s.prog_shown = true;
    # next update after another percent, but not more often than every 1 MB
    var step: u64 = s.prog_total / 100;
    if (step < 0x100000) { step = 0x100000; }
    s.prog_next = s.written + step;
}

# collect up to cap bytes in memory; more than that marks the sink failed
pub fun sink_memory(s: *Sink, buf: *u8, cap: usize) {
    sink_init(s, SINK_MEMORY, 0, false);
    s.mem     = buf;
    s.mem_cap = cap;
}

# hash and store n bytes; runs on the worker thread for piped sinks
fun consume(s: *Sink, p: *u8, n: usize) {
    s.crc = crc32.update(s.crc, p, n);
    if (s.use_blake2) { b2.sp_update(?s.blake2, p, n); }
    if (s.mode == SINK_FD && !s.failed) {
        var off: usize = 0;
        for (off < n) {
            val w: i64 = os.write(s.fd, ?p[off], n - off);
            if (w <= 0) {
                s.failed = true;
                ret;
            }
            off = off + w::usize;
        }
    }
}

pub fun sink_write(s: *Sink, p: *u8, n: usize) {
    if (n == 0) { ret; }
    if (s.mode == SINK_MEMORY) {
        s.crc = crc32.update(s.crc, p, n);
        if (s.written + n::u64 > s.mem_cap::u64) {
            s.failed = true;
        }
        or {
            M.copy(?s.mem[s.written::usize], p, n);
        }
    }
    or (s.piped) {
        # copy into chunks; the worker hashes and writes them in order
        var off: usize = 0;
        for (off < n) {
            if (s.cur < 0) {
                sem.wait(?pipe.empty);
                s.cur     = pipe.head::i64;
                s.cur_len = 0;
                pipe.head = (pipe.head + 1) % CHUNKS;
            }
            var take: usize = CHUNK - s.cur_len;
            if (take > n - off) { take = n - off; }
            M.copy(?pipe.chunks[s.cur::usize].data[s.cur_len], ?p[off], take);
            s.cur_len = s.cur_len + take;
            off       = off + take;
            if (s.cur_len == CHUNK) { submit(s); }
        }
    }
    or {
        consume(s, p, n);
    }
    s.written = s.written + n::u64;
    if (s.prog_on && s.written >= s.prog_next) { progress(s); }
}

# ---------------------------------------------------------------- worker

# checksums and file writes run on a second thread for large outputs, so
# they overlap with decompression. the decoder fills 1 MB chunks from a ring
# of four; the worker takes them in order.
val CHUNKS: usize = 4;
val CHUNK:  usize = 0x100000;

rec Chunk {
    data: *u8;
    len:  usize;
    sink: *Sink;
    stop: bool;
}

rec Pipe {
    tried:  bool;
    ok:     bool;
    chunks: [4]Chunk;
    full:   sem.Semaphore;
    empty:  sem.Semaphore;
    head:   usize;
    tail:   usize;
    worker: thread.Thread;
}

var pipe: Pipe;

fun worker(arg: *u8) {
    for {
        sem.wait(?pipe.full);
        val c: *Chunk = ?pipe.chunks[pipe.tail];
        if (c.stop) { ret; }
        consume(c.sink, c.data, c.len);
        pipe.tail = (pipe.tail + 1) % CHUNKS;
        sem.release(?pipe.empty);
    }
}

fun pipe_start() bool {
    if (pipe.tried) { ret pipe.ok; }
    pipe.tried = true;
    pipe.ok    = false;
    var i: usize = 0;
    for (i < CHUNKS) {
        pipe.chunks[i].data = M.alloc(CHUNK);
        if (pipe.chunks[i].data == nil) { ret false; }
        pipe.chunks[i].stop = false;
        i                   = i + 1;
    }
    sem.init(?pipe.full, 0, CHUNKS::i64);
    sem.init(?pipe.empty, CHUNKS::i64, CHUNKS::i64);
    pipe.head = 0;
    pipe.tail = 0;
    val r: thread.Operation = thread.spawn_with(worker, nil, ?pipe.worker);
    if (sel r.err) { ret false; }
    pipe.ok = true;
    ret true;
}

fun submit(s: *Sink) {
    val c: *Chunk = ?pipe.chunks[s.cur::usize];
    c.len  = s.cur_len;
    c.sink = s;
    c.stop = false;
    s.cur  = -1;
    sem.release(?pipe.full);
}

# hand this sink's data to the worker thread when it is large enough to be
# worth it; falls back to doing everything inline
pub fun sink_pipeline(s: *Sink, expected: u64) {
    if (s.mode == SINK_MEMORY || expected < CHUNK::u64) { ret; }
    if (!pipe_start())                                  { ret; }
    s.piped = true;
}

# wait until the worker has hashed and written everything; required before
# the sink's checksums, failure flag or the output file are looked at
pub fun sink_finish(s: *Sink) {
    if (!s.piped)   { ret; }
    if (s.cur >= 0) { submit(s); }
    # every chunk back on the empty side means the worker is idle
    var i: usize = 0;
    for (i < CHUNKS) {
        sem.wait(?pipe.empty);
        i = i + 1;
    }
    i = 0;
    for (i < CHUNKS) {
        sem.release(?pipe.empty);
        i = i + 1;
    }
    s.piped = false;
}

# stop the worker thread, if one was started
pub fun shutdown() {
    if (!pipe.ok) { ret; }
    sem.wait(?pipe.empty);
    pipe.chunks[pipe.head].stop = true;
    sem.release(?pipe.full);
    thread.join(?pipe.worker);
    pipe.ok    = false;
    pipe.tried = false;
}

pub fun sink_crc(s: *Sink) u32 {
    ret crc32.final(s.crc);
}

pub fun sink_blake2(s: *Sink, out: *u8) {
    b2.sp_final(?s.blake2, out);
}
