# the interactive terminal: detection, prompts and hidden password input
#
# prompts go to stderr and answers are read from the terminal itself
# (/dev/tty, or the console on Windows), so they work while stdout or stdin
# is redirected. without a terminal there is nobody to ask: prompt() fails
# and callers fall back to their non-interactive behavior.

use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.size.isize;
use std.types.size.usize;
use std.types.string.str;

use std.system.os;

$if ($mach.build.os == $mach.os.linux) {
    use sys: std.system.os.linux.shared;

    $if ($mach.build.arch == $mach.arch.x86_64) {
        val SYS_IOCTL: usize = 16;
    }
    $or {
        val SYS_IOCTL: usize = 29;
    }
    val TCGETS: usize = 0x5401;
    val TCSETS: usize = 0x5402;
    val ECHO:   u32   = 0x0008;
    val ECHONL: u32   = 0x0040;

    # the kernel's struct termios: 4 flag words, line discipline, 19 controls
    rec Termios {
        iflag: u32;
        oflag: u32;
        cflag: u32;
        lflag: u32;
        line:  u8;
        cc:    [19]u8;
    }

    fun ioctl(fd: i64, request: usize, argp: usize) i64 {
        ret sys.syscall3(SYS_IOCTL, fd::usize, request, argp);
    }
}
$or ($mach.build.os == $mach.os.windows) {
    #[library("kernel32.dll")]
    ext fun GetStdHandle(which: u32) isize;
    #[library("kernel32.dll")]
    ext fun GetConsoleMode(handle: isize, mode: *u32) i32;
    #[library("kernel32.dll")]
    ext fun SetConsoleMode(handle: isize, mode: u32) i32;
    #[library("kernel32.dll")]
    ext fun ReadFile(handle: isize, buf: *u8, n: u32, got: *u32, overlapped: ptr) i32;

    val STD_INPUT:         u32 = 0xFFFFFFF6;
    val STD_OUTPUT:        u32 = 0xFFFFFFF5;
    val STD_ERROR:         u32 = 0xFFFFFFF4;
    val ENABLE_ECHO_INPUT: u32 = 0x0004;
}

# does this standard stream (1 = stdout, 2 = stderr) go to a terminal
pub fun is_terminal(fd: i64) bool {
    $if ($mach.build.os == $mach.os.linux) {
        var t: Termios;
        ret ioctl(fd, TCGETS, (?t)::usize) == 0;
    }
    $or ($mach.build.os == $mach.os.windows) {
        var which: u32 = STD_OUTPUT;
        if (fd == 2) { which = STD_ERROR; }
        if (fd == 0) { which = STD_INPUT; }
        var mode: u32 = 0;
        ret GetConsoleMode(GetStdHandle(which), ?mode) != 0;
    }
    $or {
        ret false;
    }
}

# is there a terminal to ask questions on
pub fun available() bool {
    $if ($mach.build.os == $mach.os.linux) {
        var fd: usize = 0;
        if (os.open(os.working_dir(), "/dev/tty"::*u8, 2, 0, ?fd) < 0) { ret false; }
        var t:  Termios;
        val ok: bool = ioctl(fd::i64, TCGETS, (?t)::usize) == 0;
        os.close(fd);
        ret ok;
    }
    $or ($mach.build.os == $mach.os.windows) {
        var mode: u32 = 0;
        ret GetConsoleMode(GetStdHandle(STD_INPUT), ?mode) != 0;
    }
    $or {
        ret false;
    }
}

# ask a question on the terminal and read one line of answer
# ---
# question: shown on stderr, as is
# buf, cap: receives the answer without its line end, NUL-terminated
# hidden: do not echo what is typed (passwords)
# ret:    answer length, or -1 when there is no terminal to ask
pub fun prompt(question: str, buf: *u8, cap: usize, hidden: bool) i64 {
    $if ($mach.build.os == $mach.os.linux) {
        var fd: usize = 0;
        if (os.open(os.working_dir(), "/dev/tty"::*u8, 2, 0, ?fd) < 0) { ret -1; }
        var saved: Termios;
        if (ioctl(fd::i64, TCGETS, (?saved)::usize) != 0) {
            os.close(fd);
            ret -1;
        }
        print.eprint(question);
        if (hidden) {
            var quiet: Termios = saved;
            quiet.lflag = (quiet.lflag & ~ECHO) | ECHONL;
            ioctl(fd::i64, TCSETS, (?quiet)::usize);
        }
        val n: i64 = read_line(fd, buf, cap);
        if (hidden) { ioctl(fd::i64, TCSETS, (?saved)::usize); }
        os.close(fd);
        ret n;
    }
    $or ($mach.build.os == $mach.os.windows) {
        val h:    isize = GetStdHandle(STD_INPUT);
        var mode: u32   = 0;
        if (GetConsoleMode(h, ?mode) == 0) { ret -1; }
        print.eprint(question);
        if (hidden) { SetConsoleMode(h, mode & ~ENABLE_ECHO_INPUT); }
        var n: usize = 0;
        for (n + 1 < cap) {
            var c:   u8  = 0;
            var got: u32 = 0;
            if (ReadFile(h, ?c, 1, ?got, nil) == 0 || got == 0) { brk; }
            if (c == '\n')                                      { brk; }
            if (c != '\r') {
                buf[n] = c;
                n      = n + 1;
            }
        }
        buf[n] = 0;
        if (hidden) {
            SetConsoleMode(h, mode);
            print.eprintln("");
        }
        ret n::i64;
    }
    $or {
        ret -1;
    }
}

fun read_line(fd: usize, buf: *u8, cap: usize) i64 {
    var n: usize = 0;
    for (n + 1 < cap) {
        var c: u8  = 0;
        val r: i64 = os.read(fd, ?c, 1);
        if (r <= 0) {
            if (n == 0) {
                buf[0] = 0;
                ret -1;
            }
            brk;
        }
        if (c == '\n') { brk; }
        if (c != '\r') {
            buf[n] = c;
            n      = n + 1;
        }
    }
    buf[n] = 0;
    ret n::i64;
}

# monotonic time in milliseconds
pub fun millis() i64 {
    var ts: os.Timespec;
    if (os.monotonic(?ts) < 0) { ret 0; }
    ret ts.sec * 1000 + ts.nsec / 1000000;
}
